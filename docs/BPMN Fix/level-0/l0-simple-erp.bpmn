    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="l0_simple_erp_Flow_4" sourceRef="l0_simple_erp_branch" targetRef="l0_simple_erp_call1">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="text/plain">Procure to Pay</bpmn:conditionExpression>
