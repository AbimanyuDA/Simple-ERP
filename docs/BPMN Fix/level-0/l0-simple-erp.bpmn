    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="l0_simple_erp_Flow_12" sourceRef="l0_simple_erp_branch" targetRef="l0_simple_erp_call5">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="text/plain">Master data dan konfigurasi</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
