<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:tns="https://simple-erp.local/bpm-haqi/l2-session" xmlns:c0="https://simple-erp.local/bpm-haqi/l3-login" xmlns:c1="https://simple-erp.local/bpm-haqi/l3-refresh" xmlns:c2="https://simple-erp.local/bpm-haqi/l3-logout" xmlns:c3="https://simple-erp.local/bpm-haqi/l3-reset-request" xmlns:c4="https://simple-erp.local/bpm-haqi/l3-reset-consume" id="Definitions_l2_session" targetNamespace="https://simple-erp.local/bpm-haqi/l2-session" exporter="Simple ERP source-backed documentation" exporterVersion="1">
  <bpmn:import namespace="https://simple-erp.local/bpm-haqi/l3-login" location="../level-3/l3-login.bpmn" importType="http://www.omg.org/spec/BPMN/20100524/MODEL"/>
  <bpmn:import namespace="https://simple-erp.local/bpm-haqi/l3-refresh" location="../level-3/l3-refresh.bpmn" importType="http://www.omg.org/spec/BPMN/20100524/MODEL"/>
  <bpmn:import namespace="https://simple-erp.local/bpm-haqi/l3-logout" location="../level-3/l3-logout.bpmn" importType="http://www.omg.org/spec/BPMN/20100524/MODEL"/>
  <bpmn:import namespace="https://simple-erp.local/bpm-haqi/l3-reset-request" location="../level-3/l3-reset-request.bpmn" importType="http://www.omg.org/spec/BPMN/20100524/MODEL"/>
  <bpmn:import namespace="https://simple-erp.local/bpm-haqi/l3-reset-consume" location="../level-3/l3-reset-consume.bpmn" importType="http://www.omg.org/spec/BPMN/20100524/MODEL"/>
  <bpmn:process id="Process_l2_session" name="Login, sesi dan pemulihan password" isExecutable="false">
    <bpmn:documentation>Level 2; source snapshot 2026-10-21; descriptive as-is working tree, not deployed-runtime proof.</bpmn:documentation>
    <bpmn:laneSet id="Lanes_l2_session">
      <bpmn:lane id="Lane_l2_session_0" name="Pemilik kebutuhan (role pada detail)">
        <bpmn:flowNodeRef>l2_session_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l2_session_choose</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l2_session_branch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l2_session_call0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l2_session_end0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l2_session_call1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l2_session_end1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l2_session_call2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l2_session_end2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l2_session_call3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l2_session_end3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l2_session_call4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l2_session_end4</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="l2_session_start" name="Kebutuhan muncul">
      <bpmn:outgoing>l2_session_Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="l2_session_choose" name="Pilih kebutuhan">
      <bpmn:incoming>l2_session_Flow_0</bpmn:incoming>
      <bpmn:outgoing>l2_session_Flow_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="l2_session_branch" name="Kebutuhan apa?" default="l2_session_Flow_10" gatewayDirection="Diverging">
      <bpmn:incoming>l2_session_Flow_1</bpmn:incoming>
      <bpmn:outgoing>l2_session_Flow_2</bpmn:outgoing>
      <bpmn:outgoing>l2_session_Flow_4</bpmn:outgoing>
      <bpmn:outgoing>l2_session_Flow_6</bpmn:outgoing>
      <bpmn:outgoing>l2_session_Flow_8</bpmn:outgoing>
      <bpmn:outgoing>l2_session_Flow_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="l2_session_call0" name="Login" calledElement="c0:Process_l3_login">
      <bpmn:incoming>l2_session_Flow_2</bpmn:incoming>
      <bpmn:outgoing>l2_session_Flow_3</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:endEvent id="l2_session_end0" name="Aksi selesai / hasil diterima">
      <bpmn:incoming>l2_session_Flow_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:callActivity id="l2_session_call1" name="Refresh sesi" calledElement="c1:Process_l3_refresh">
      <bpmn:incoming>l2_session_Flow_4</bpmn:incoming>
      <bpmn:outgoing>l2_session_Flow_5</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:endEvent id="l2_session_end1" name="Aksi selesai / hasil diterima">
      <bpmn:incoming>l2_session_Flow_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:callActivity id="l2_session_call2" name="Logout" calledElement="c2:Process_l3_logout">
      <bpmn:incoming>l2_session_Flow_6</bpmn:incoming>
      <bpmn:outgoing>l2_session_Flow_7</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:endEvent id="l2_session_end2" name="Aksi selesai / hasil diterima">
      <bpmn:incoming>l2_session_Flow_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:callActivity id="l2_session_call3" name="Terbitkan reset oleh owner" calledElement="c3:Process_l3_reset_request">
      <bpmn:incoming>l2_session_Flow_8</bpmn:incoming>
      <bpmn:outgoing>l2_session_Flow_9</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:endEvent id="l2_session_end3" name="Aksi selesai / hasil diterima">
      <bpmn:incoming>l2_session_Flow_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:callActivity id="l2_session_call4" name="Gunakan token reset" calledElement="c4:Process_l3_reset_consume">
      <bpmn:incoming>l2_session_Flow_10</bpmn:incoming>
      <bpmn:outgoing>l2_session_Flow_11</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:endEvent id="l2_session_end4" name="Aksi selesai / hasil diterima">
      <bpmn:incoming>l2_session_Flow_11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="l2_session_Flow_0" sourceRef="l2_session_start" targetRef="l2_session_choose"/>
    <bpmn:sequenceFlow id="l2_session_Flow_1" sourceRef="l2_session_choose" targetRef="l2_session_branch"/>
    <bpmn:sequenceFlow id="l2_session_Flow_2" sourceRef="l2_session_branch" targetRef="l2_session_call0" name="Login">
      <bpmn:conditionExpression language="text/plain" xsi:type="bpmn:tFormalExpression">Login</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="l2_session_Flow_3" sourceRef="l2_session_call0" targetRef="l2_session_end0"/>
    <bpmn:sequenceFlow id="l2_session_Flow_4" sourceRef="l2_session_branch" targetRef="l2_session_call1" name="Refresh sesi">
      <bpmn:conditionExpression language="text/plain" xsi:type="bpmn:tFormalExpression">Refresh sesi</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="l2_session_Flow_5" sourceRef="l2_session_call1" targetRef="l2_session_end1"/>
    <bpmn:sequenceFlow id="l2_session_Flow_6" sourceRef="l2_session_branch" targetRef="l2_session_call2" name="Logout">
      <bpmn:conditionExpression language="text/plain" xsi:type="bpmn:tFormalExpression">Logout</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="l2_session_Flow_7" sourceRef="l2_session_call2" targetRef="l2_session_end2"/>
    <bpmn:sequenceFlow id="l2_session_Flow_8" sourceRef="l2_session_branch" targetRef="l2_session_call3" name="Terbitkan reset oleh owner">
      <bpmn:conditionExpression language="text/plain" xsi:type="bpmn:tFormalExpression">Terbitkan reset oleh owner</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="l2_session_Flow_9" sourceRef="l2_session_call3" targetRef="l2_session_end3"/>
    <bpmn:sequenceFlow id="l2_session_Flow_10" sourceRef="l2_session_branch" targetRef="l2_session_call4" name="Gunakan token reset"/>
    <bpmn:sequenceFlow id="l2_session_Flow_11" sourceRef="l2_session_call4" targetRef="l2_session_end4"/>
  </bpmn:process>
  <bpmn:collaboration id="Collab_l2_session">
    <bpmn:participant id="Pool_l2_session" name="Simple ERP" processRef="Process_l2_session"/>
  </bpmn:collaboration>
