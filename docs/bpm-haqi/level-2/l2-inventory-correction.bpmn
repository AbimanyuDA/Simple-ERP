<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:tns="https://simple-erp.local/bpm-haqi/l2-inventory-correction" xmlns:c0="https://simple-erp.local/bpm-haqi/l3-operational-read" xmlns:c1="https://simple-erp.local/bpm-haqi/l3-adj-cancel" xmlns:c2="https://simple-erp.local/bpm-haqi/l3-adj-reverse" id="Definitions_l2_inventory_correction" targetNamespace="https://simple-erp.local/bpm-haqi/l2-inventory-correction" exporter="Simple ERP source-backed documentation" exporterVersion="1">
  <bpmn:import namespace="https://simple-erp.local/bpm-haqi/l3-operational-read" location="../level-3/l3-operational-read.bpmn" importType="http://www.omg.org/spec/BPMN/20100524/MODEL"/>
  <bpmn:import namespace="https://simple-erp.local/bpm-haqi/l3-adj-cancel" location="../level-3/l3-adj-cancel.bpmn" importType="http://www.omg.org/spec/BPMN/20100524/MODEL"/>
  <bpmn:import namespace="https://simple-erp.local/bpm-haqi/l3-adj-reverse" location="../level-3/l3-adj-reverse.bpmn" importType="http://www.omg.org/spec/BPMN/20100524/MODEL"/>
  <bpmn:process id="Process_l2_inventory_correction" name="Koreksi adjustment dan pembacaan stok" isExecutable="false">
    <bpmn:documentation>Level 2; source snapshot 2026-10-21; descriptive as-is working tree, not deployed-runtime proof.</bpmn:documentation>
    <bpmn:laneSet id="Lanes_l2_inventory_correction">
      <bpmn:lane id="Lane_l2_inventory_correction_0" name="Pemilik kebutuhan (role pada detail)">
        <bpmn:flowNodeRef>l2_inventory_correction_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l2_inventory_correction_choose</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l2_inventory_correction_branch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l2_inventory_correction_call0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l2_inventory_correction_end0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l2_inventory_correction_call1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l2_inventory_correction_end1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l2_inventory_correction_call2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l2_inventory_correction_end2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="l2_inventory_correction_start" name="Kebutuhan muncul">
      <bpmn:outgoing>l2_inventory_correction_Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="l2_inventory_correction_choose" name="Pilih kebutuhan">
      <bpmn:incoming>l2_inventory_correction_Flow_0</bpmn:incoming>
      <bpmn:outgoing>l2_inventory_correction_Flow_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="l2_inventory_correction_branch" name="Kebutuhan apa?" default="l2_inventory_correction_Flow_6" gatewayDirection="Diverging">
      <bpmn:incoming>l2_inventory_correction_Flow_1</bpmn:incoming>
      <bpmn:outgoing>l2_inventory_correction_Flow_2</bpmn:outgoing>
      <bpmn:outgoing>l2_inventory_correction_Flow_4</bpmn:outgoing>
      <bpmn:outgoing>l2_inventory_correction_Flow_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="l2_inventory_correction_call0" name="Baca saldo/movement" calledElement="c0:Process_l3_operational_read">
      <bpmn:incoming>l2_inventory_correction_Flow_2</bpmn:incoming>
      <bpmn:outgoing>l2_inventory_correction_Flow_3</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:endEvent id="l2_inventory_correction_end0" name="Aksi selesai / hasil diterima">
      <bpmn:incoming>l2_inventory_correction_Flow_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:callActivity id="l2_inventory_correction_call1" name="Cancel draft/approved" calledElement="c1:Process_l3_adj_cancel">
      <bpmn:incoming>l2_inventory_correction_Flow_4</bpmn:incoming>
      <bpmn:outgoing>l2_inventory_correction_Flow_5</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:endEvent id="l2_inventory_correction_end1" name="Aksi selesai / hasil diterima">
      <bpmn:incoming>l2_inventory_correction_Flow_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:callActivity id="l2_inventory_correction_call2" name="Reverse completed" calledElement="c2:Process_l3_adj_reverse">
      <bpmn:incoming>l2_inventory_correction_Flow_6</bpmn:incoming>
      <bpmn:outgoing>l2_inventory_correction_Flow_7</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:endEvent id="l2_inventory_correction_end2" name="Aksi selesai / hasil diterima">
      <bpmn:incoming>l2_inventory_correction_Flow_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="l2_inventory_correction_Flow_0" sourceRef="l2_inventory_correction_start" targetRef="l2_inventory_correction_choose"/>
    <bpmn:sequenceFlow id="l2_inventory_correction_Flow_1" sourceRef="l2_inventory_correction_choose" targetRef="l2_inventory_correction_branch"/>
    <bpmn:sequenceFlow id="l2_inventory_correction_Flow_2" sourceRef="l2_inventory_correction_branch" targetRef="l2_inventory_correction_call0" name="Baca saldo/movement">
      <bpmn:conditionExpression language="text/plain" xsi:type="bpmn:tFormalExpression">Baca saldo/movement</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="l2_inventory_correction_Flow_3" sourceRef="l2_inventory_correction_call0" targetRef="l2_inventory_correction_end0"/>
    <bpmn:sequenceFlow id="l2_inventory_correction_Flow_4" sourceRef="l2_inventory_correction_branch" targetRef="l2_inventory_correction_call1" name="Cancel draft/approved">
      <bpmn:conditionExpression language="text/plain" xsi:type="bpmn:tFormalExpression">Cancel draft/approved</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="l2_inventory_correction_Flow_5" sourceRef="l2_inventory_correction_call1" targetRef="l2_inventory_correction_end1"/>
    <bpmn:sequenceFlow id="l2_inventory_correction_Flow_6" sourceRef="l2_inventory_correction_branch" targetRef="l2_inventory_correction_call2" name="Reverse completed"/>
    <bpmn:sequenceFlow id="l2_inventory_correction_Flow_7" sourceRef="l2_inventory_correction_call2" targetRef="l2_inventory_correction_end2"/>
  </bpmn:process>
  <bpmn:collaboration id="Collab_l2_inventory_correction">
