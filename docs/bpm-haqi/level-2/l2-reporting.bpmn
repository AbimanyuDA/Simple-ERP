<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:tns="https://simple-erp.local/bpm-haqi/l2-reporting" xmlns:c0="https://simple-erp.local/bpm-haqi/l3-dashboard" xmlns:c1="https://simple-erp.local/bpm-haqi/l3-operational-read" xmlns:c2="https://simple-erp.local/bpm-haqi/l3-finance-read" xmlns:c3="https://simple-erp.local/bpm-haqi/l3-report" id="Definitions_l2_reporting" targetNamespace="https://simple-erp.local/bpm-haqi/l2-reporting" exporter="Simple ERP source-backed documentation" exporterVersion="1">
  <bpmn:import namespace="https://simple-erp.local/bpm-haqi/l3-dashboard" location="../level-3/l3-dashboard.bpmn" importType="http://www.omg.org/spec/BPMN/20100524/MODEL"/>
  <bpmn:import namespace="https://simple-erp.local/bpm-haqi/l3-operational-read" location="../level-3/l3-operational-read.bpmn" importType="http://www.omg.org/spec/BPMN/20100524/MODEL"/>
  <bpmn:import namespace="https://simple-erp.local/bpm-haqi/l3-finance-read" location="../level-3/l3-finance-read.bpmn" importType="http://www.omg.org/spec/BPMN/20100524/MODEL"/>
  <bpmn:import namespace="https://simple-erp.local/bpm-haqi/l3-report" location="../level-3/l3-report.bpmn" importType="http://www.omg.org/spec/BPMN/20100524/MODEL"/>
  <bpmn:process id="Process_l2_reporting" name="Dashboard, daftar, laporan dan audit" isExecutable="false">
    <bpmn:documentation>Level 2; source snapshot 2026-10-21; descriptive as-is working tree, not deployed-runtime proof.</bpmn:documentation>
    <bpmn:laneSet id="Lanes_l2_reporting">
      <bpmn:lane id="Lane_l2_reporting_0" name="Pemilik kebutuhan (role pada detail)">
        <bpmn:flowNodeRef>l2_reporting_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l2_reporting_choose</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l2_reporting_branch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l2_reporting_call0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l2_reporting_end0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l2_reporting_call1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l2_reporting_end1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l2_reporting_call2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l2_reporting_end2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l2_reporting_call3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l2_reporting_end3</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="l2_reporting_start" name="Kebutuhan muncul">
      <bpmn:outgoing>l2_reporting_Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="l2_reporting_choose" name="Pilih kebutuhan">
      <bpmn:incoming>l2_reporting_Flow_0</bpmn:incoming>
      <bpmn:outgoing>l2_reporting_Flow_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="l2_reporting_branch" name="Kebutuhan apa?" default="l2_reporting_Flow_8" gatewayDirection="Diverging">
      <bpmn:incoming>l2_reporting_Flow_1</bpmn:incoming>
      <bpmn:outgoing>l2_reporting_Flow_2</bpmn:outgoing>
      <bpmn:outgoing>l2_reporting_Flow_4</bpmn:outgoing>
      <bpmn:outgoing>l2_reporting_Flow_6</bpmn:outgoing>
      <bpmn:outgoing>l2_reporting_Flow_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="l2_reporting_call0" name="Dashboard semua role" calledElement="c0:Process_l3_dashboard">
      <bpmn:incoming>l2_reporting_Flow_2</bpmn:incoming>
      <bpmn:outgoing>l2_reporting_Flow_3</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:endEvent id="l2_reporting_end0" name="Aksi selesai / hasil diterima">
      <bpmn:incoming>l2_reporting_Flow_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:callActivity id="l2_reporting_call1" name="Daftar/detail operasional" calledElement="c1:Process_l3_operational_read">
      <bpmn:incoming>l2_reporting_Flow_4</bpmn:incoming>
      <bpmn:outgoing>l2_reporting_Flow_5</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:endEvent id="l2_reporting_end1" name="Aksi selesai / hasil diterima">
      <bpmn:incoming>l2_reporting_Flow_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:callActivity id="l2_reporting_call2" name="Baca finance" calledElement="c2:Process_l3_finance_read">
      <bpmn:incoming>l2_reporting_Flow_6</bpmn:incoming>
      <bpmn:outgoing>l2_reporting_Flow_7</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:endEvent id="l2_reporting_end2" name="Aksi selesai / hasil diterima">
      <bpmn:incoming>l2_reporting_Flow_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:callActivity id="l2_reporting_call3" name="Laporan/audit" calledElement="c3:Process_l3_report">
      <bpmn:incoming>l2_reporting_Flow_8</bpmn:incoming>
      <bpmn:outgoing>l2_reporting_Flow_9</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:endEvent id="l2_reporting_end3" name="Aksi selesai / hasil diterima">
      <bpmn:incoming>l2_reporting_Flow_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="l2_reporting_Flow_0" sourceRef="l2_reporting_start" targetRef="l2_reporting_choose"/>
    <bpmn:sequenceFlow id="l2_reporting_Flow_1" sourceRef="l2_reporting_choose" targetRef="l2_reporting_branch"/>
    <bpmn:sequenceFlow id="l2_reporting_Flow_2" sourceRef="l2_reporting_branch" targetRef="l2_reporting_call0" name="Dashboard semua role">
      <bpmn:conditionExpression language="text/plain" xsi:type="bpmn:tFormalExpression">Dashboard semua role</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="l2_reporting_Flow_3" sourceRef="l2_reporting_call0" targetRef="l2_reporting_end0"/>
    <bpmn:sequenceFlow id="l2_reporting_Flow_4" sourceRef="l2_reporting_branch" targetRef="l2_reporting_call1" name="Daftar/detail operasional">
      <bpmn:conditionExpression language="text/plain" xsi:type="bpmn:tFormalExpression">Daftar/detail operasional</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="l2_reporting_Flow_5" sourceRef="l2_reporting_call1" targetRef="l2_reporting_end1"/>
    <bpmn:sequenceFlow id="l2_reporting_Flow_6" sourceRef="l2_reporting_branch" targetRef="l2_reporting_call2" name="Baca finance">
      <bpmn:conditionExpression language="text/plain" xsi:type="bpmn:tFormalExpression">Baca finance</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="l2_reporting_Flow_7" sourceRef="l2_reporting_call2" targetRef="l2_reporting_end2"/>
    <bpmn:sequenceFlow id="l2_reporting_Flow_8" sourceRef="l2_reporting_branch" targetRef="l2_reporting_call3" name="Laporan/audit"/>
    <bpmn:sequenceFlow id="l2_reporting_Flow_9" sourceRef="l2_reporting_call3" targetRef="l2_reporting_end3"/>
  </bpmn:process>
  <bpmn:collaboration id="Collab_l2_reporting">
    <bpmn:participant id="Pool_l2_reporting" name="Simple ERP" processRef="Process_l2_reporting"/>
  </bpmn:collaboration>
