<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:tns="https://simple-erp.local/bpm-haqi/l2-po-gr" xmlns:c0="https://simple-erp.local/bpm-haqi/l3-po-convert" xmlns:c1="https://simple-erp.local/bpm-haqi/l3-po-issue" xmlns:c2="https://simple-erp.local/bpm-haqi/l3-gr-create" xmlns:c3="https://simple-erp.local/bpm-haqi/l3-gr-post" id="Definitions_l2_po_gr" targetNamespace="https://simple-erp.local/bpm-haqi/l2-po-gr" exporter="Simple ERP source-backed documentation" exporterVersion="1">
  <bpmn:import namespace="https://simple-erp.local/bpm-haqi/l3-po-convert" location="../level-3-p2p/l3-po-convert.bpmn" importType="http://www.omg.org/spec/BPMN/20100524/MODEL"/>
  <bpmn:import namespace="https://simple-erp.local/bpm-haqi/l3-po-issue" location="../level-3-p2p/l3-po-issue.bpmn" importType="http://www.omg.org/spec/BPMN/20100524/MODEL"/>
  <bpmn:import namespace="https://simple-erp.local/bpm-haqi/l3-gr-create" location="../level-3-p2p/l3-gr-create.bpmn" importType="http://www.omg.org/spec/BPMN/20100524/MODEL"/>
  <bpmn:import namespace="https://simple-erp.local/bpm-haqi/l3-gr-post" location="../level-3-p2p/l3-gr-post.bpmn" importType="http://www.omg.org/spec/BPMN/20100524/MODEL"/>
  <bpmn:process id="Process_l2_po_gr" name="Purchase Order dan penerimaan barang" isExecutable="false">
    <bpmn:documentation>Level 2; source snapshot 2026-10-21; descriptive as-is working tree, not deployed-runtime proof.
Satu iterasi penerimaan. Jika PO PARTIALLY_RECEIVED, buat dan post GR berikutnya; hanya PO RECEIVED dapat dibuatkan invoice.
backend/internal/purchasing/adapter/postgres/store.go :: ConvertToOrder / IssueOrder / CreateReceipt / PostReceipt</bpmn:documentation>
    <bpmn:laneSet id="Lanes_l2_po_gr">
      <bpmn:lane id="Lane_l2_po_gr_0" name="Staff atau Super Admin">
        <bpmn:flowNodeRef>l2_po_gr_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l2_po_gr_stage0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l2_po_gr_stage2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_l2_po_gr_1" name="Sistem Simple ERP">
        <bpmn:flowNodeRef>l2_po_gr_gate0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l2_po_gr_exit0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l2_po_gr_gate1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l2_po_gr_exit1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l2_po_gr_gate2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l2_po_gr_exit2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l2_po_gr_gate3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l2_po_gr_exit3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l2_po_gr_end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_l2_po_gr_2" name="Supervisor atau Super Admin">
        <bpmn:flowNodeRef>l2_po_gr_stage1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l2_po_gr_stage3</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="l2_po_gr_start" name="Kebutuhan dokumen">
      <bpmn:outgoing>l2_po_gr_Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:callActivity id="l2_po_gr_stage0" name="Konversi PR APPROVED" calledElement="c0:Process_l3_po_convert">
      <bpmn:incoming>l2_po_gr_Flow_0</bpmn:incoming>
      <bpmn:outgoing>l2_po_gr_Flow_1</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="l2_po_gr_gate0" name="PO DRAFT berhasil?" default="l2_po_gr_Flow_2" gatewayDirection="Diverging">
      <bpmn:incoming>l2_po_gr_Flow_1</bpmn:incoming>
      <bpmn:outgoing>l2_po_gr_Flow_2</bpmn:outgoing>
      <bpmn:outgoing>l2_po_gr_Flow_3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="l2_po_gr_exit0" name="PO belum dibuat">
      <bpmn:incoming>l2_po_gr_Flow_2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:callActivity id="l2_po_gr_stage1" name="Supervisor issue PO" calledElement="c1:Process_l3_po_issue">
      <bpmn:incoming>l2_po_gr_Flow_3</bpmn:incoming>
      <bpmn:outgoing>l2_po_gr_Flow_4</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="l2_po_gr_gate1" name="PO ISSUED?" default="l2_po_gr_Flow_5" gatewayDirection="Diverging">
      <bpmn:incoming>l2_po_gr_Flow_4</bpmn:incoming>
      <bpmn:outgoing>l2_po_gr_Flow_5</bpmn:outgoing>
      <bpmn:outgoing>l2_po_gr_Flow_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="l2_po_gr_exit1" name="PO belum issued">
      <bpmn:incoming>l2_po_gr_Flow_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:callActivity id="l2_po_gr_stage2" name="Catat penerimaan" calledElement="c2:Process_l3_gr_create">
      <bpmn:incoming>l2_po_gr_Flow_6</bpmn:incoming>
      <bpmn:incoming>l2_po_gr_Flow_12</bpmn:incoming>
      <bpmn:outgoing>l2_po_gr_Flow_7</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="l2_po_gr_gate2" name="GR DRAFT berhasil?" default="l2_po_gr_Flow_8" gatewayDirection="Diverging">
      <bpmn:incoming>l2_po_gr_Flow_7</bpmn:incoming>
      <bpmn:outgoing>l2_po_gr_Flow_8</bpmn:outgoing>
      <bpmn:outgoing>l2_po_gr_Flow_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="l2_po_gr_exit2" name="GR belum dicatat">
      <bpmn:incoming>l2_po_gr_Flow_8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:callActivity id="l2_po_gr_stage3" name="Supervisor post penerimaan" calledElement="c3:Process_l3_gr_post">
      <bpmn:incoming>l2_po_gr_Flow_9</bpmn:incoming>
      <bpmn:outgoing>l2_po_gr_Flow_10</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="l2_po_gr_gate3" name="Hasil posting GR dan PO?" default="l2_po_gr_Flow_13" gatewayDirection="Diverging">
      <bpmn:incoming>l2_po_gr_Flow_10</bpmn:incoming>
      <bpmn:outgoing>l2_po_gr_Flow_11</bpmn:outgoing>
      <bpmn:outgoing>l2_po_gr_Flow_12</bpmn:outgoing>
      <bpmn:outgoing>l2_po_gr_Flow_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="l2_po_gr_exit3" name="GR belum posted">
      <bpmn:incoming>l2_po_gr_Flow_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="l2_po_gr_end" name="Tahap selesai">
      <bpmn:incoming>l2_po_gr_Flow_11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="l2_po_gr_Flow_0" sourceRef="l2_po_gr_start" targetRef="l2_po_gr_stage0"/>
    <bpmn:sequenceFlow id="l2_po_gr_Flow_1" sourceRef="l2_po_gr_stage0" targetRef="l2_po_gr_gate0"/>
    <bpmn:sequenceFlow id="l2_po_gr_Flow_2" sourceRef="l2_po_gr_gate0" targetRef="l2_po_gr_exit0" name="Tidak"/>
    <bpmn:sequenceFlow id="l2_po_gr_Flow_3" sourceRef="l2_po_gr_gate0" targetRef="l2_po_gr_stage1" name="Ya">
      <bpmn:conditionExpression language="text/plain" xsi:type="bpmn:tFormalExpression">Ya</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="l2_po_gr_Flow_4" sourceRef="l2_po_gr_stage1" targetRef="l2_po_gr_gate1"/>
    <bpmn:sequenceFlow id="l2_po_gr_Flow_5" sourceRef="l2_po_gr_gate1" targetRef="l2_po_gr_exit1" name="Tidak"/>
    <bpmn:sequenceFlow id="l2_po_gr_Flow_6" sourceRef="l2_po_gr_gate1" targetRef="l2_po_gr_stage2" name="Ya">
      <bpmn:conditionExpression language="text/plain" xsi:type="bpmn:tFormalExpression">Ya</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="l2_po_gr_Flow_7" sourceRef="l2_po_gr_stage2" targetRef="l2_po_gr_gate2"/>
    <bpmn:sequenceFlow id="l2_po_gr_Flow_8" sourceRef="l2_po_gr_gate2" targetRef="l2_po_gr_exit2" name="Tidak"/>
    <bpmn:sequenceFlow id="l2_po_gr_Flow_9" sourceRef="l2_po_gr_gate2" targetRef="l2_po_gr_stage3" name="Ya">
      <bpmn:conditionExpression language="text/plain" xsi:type="bpmn:tFormalExpression">Ya</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="l2_po_gr_Flow_10" sourceRef="l2_po_gr_stage3" targetRef="l2_po_gr_gate3"/>
    <bpmn:sequenceFlow id="l2_po_gr_Flow_11" sourceRef="l2_po_gr_gate3" targetRef="l2_po_gr_end" name="PO RECEIVED">
      <bpmn:conditionExpression language="text/plain" xsi:type="bpmn:tFormalExpression">PO RECEIVED</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="l2_po_gr_Flow_12" sourceRef="l2_po_gr_gate3" targetRef="l2_po_gr_stage2" name="PO PARTIALLY_RECEIVED">
      <bpmn:conditionExpression language="text/plain" xsi:type="bpmn:tFormalExpression">PO PARTIALLY_RECEIVED</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="l2_po_gr_Flow_13" sourceRef="l2_po_gr_gate3" targetRef="l2_po_gr_exit3" name="GR tidak POSTED"/>
  </bpmn:process>
