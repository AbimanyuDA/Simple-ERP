      <bpmn:incoming>l2_master_settings_Flow_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:callActivity id="l2_master_settings_call2" name="Ubah status master" calledElement="c2:Process_l3_master_status">
      <bpmn:incoming>l2_master_settings_Flow_6</bpmn:incoming>
      <bpmn:outgoing>l2_master_settings_Flow_7</bpmn:outgoing>
