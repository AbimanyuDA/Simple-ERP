    <bpmn:callActivity id="l2_master_settings_call0" name="Baca master" calledElement="c0:Process_l3_operational_read">
      <bpmn:incoming>l2_master_settings_Flow_2</bpmn:incoming>
      <bpmn:outgoing>l2_master_settings_Flow_3</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:endEvent id="l2_master_settings_end0" name="Aksi selesai / hasil diterima">
      <bpmn:incoming>l2_master_settings_Flow_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:callActivity id="l2_master_settings_call1" name="Buat master" calledElement="c1:Process_l3_master_create">
      <bpmn:incoming>l2_master_settings_Flow_4</bpmn:incoming>
