    <bpmn:startEvent id="l2_master_settings_start" name="Kebutuhan muncul">
      <bpmn:outgoing>l2_master_settings_Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="l2_master_settings_choose" name="Pilih kebutuhan">
      <bpmn:incoming>l2_master_settings_Flow_0</bpmn:incoming>
      <bpmn:outgoing>l2_master_settings_Flow_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="l2_master_settings_branch" name="Kebutuhan apa?" default="l2_master_settings_Flow_10" gatewayDirection="Diverging">
      <bpmn:incoming>l2_master_settings_Flow_1</bpmn:incoming>
      <bpmn:outgoing>l2_master_settings_Flow_2</bpmn:outgoing>
