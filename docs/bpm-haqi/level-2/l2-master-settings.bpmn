  <bpmn:process id="Process_l2_master_settings" name="Pemeliharaan master dan konfigurasi" isExecutable="false">
    <bpmn:documentation>Level 2; source snapshot 2026-10-21; descriptive as-is working tree, not deployed-runtime proof.</bpmn:documentation>
    <bpmn:laneSet id="Lanes_l2_master_settings">
      <bpmn:lane id="Lane_l2_master_settings_0" name="Pemilik kebutuhan (role pada detail)">
