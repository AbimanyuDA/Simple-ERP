    <bpmn:callActivity id="l2_access_call3" name="Aktivasi undangan" calledElement="c3:Process_l3_activate_invitation">
      <bpmn:incoming>l2_access_Flow_8</bpmn:incoming>
      <bpmn:outgoing>l2_access_Flow_9</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:endEvent id="l2_access_end3" name="Aksi selesai / hasil diterima">
      <bpmn:incoming>l2_access_Flow_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:callActivity id="l2_access_call4" name="Status pengguna" calledElement="c4:Process_l3_user_status">
      <bpmn:incoming>l2_access_Flow_10</bpmn:incoming>
      <bpmn:outgoing>l2_access_Flow_11</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:endEvent id="l2_access_end4" name="Aksi selesai / hasil diterima">
      <bpmn:incoming>l2_access_Flow_11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:callActivity id="l2_access_call5" name="Cabut sesi" calledElement="c5:Process_l3_session_revoke">
      <bpmn:incoming>l2_access_Flow_12</bpmn:incoming>
