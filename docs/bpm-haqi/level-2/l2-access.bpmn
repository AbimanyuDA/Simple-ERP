        <bpmn:flowNodeRef>l2_access_end3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l2_access_call4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l2_access_end4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l2_access_call5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l2_access_end5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l2_access_call6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l2_access_end6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l2_access_call7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l2_access_end7</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="l2_access_start" name="Kebutuhan muncul">
      <bpmn:outgoing>l2_access_Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="l2_access_choose" name="Pilih kebutuhan">
      <bpmn:incoming>l2_access_Flow_0</bpmn:incoming>
      <bpmn:outgoing>l2_access_Flow_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="l2_access_branch" name="Kebutuhan apa?" default="l2_access_Flow_16" gatewayDirection="Diverging">
      <bpmn:incoming>l2_access_Flow_1</bpmn:incoming>
      <bpmn:outgoing>l2_access_Flow_2</bpmn:outgoing>
      <bpmn:outgoing>l2_access_Flow_4</bpmn:outgoing>
      <bpmn:outgoing>l2_access_Flow_6</bpmn:outgoing>
