        <bpmn:flowNodeRef>l2_access_end1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l2_access_call2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l2_access_end2</bpmn:flowNodeRef>
