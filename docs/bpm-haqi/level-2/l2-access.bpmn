      <bpmn:outgoing>l2_access_Flow_12</bpmn:outgoing>
      <bpmn:outgoing>l2_access_Flow_14</bpmn:outgoing>
      <bpmn:outgoing>l2_access_Flow_16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="l2_access_call0" name="Bootstrap awal" calledElement="c0:Process_l3_bootstrap">
      <bpmn:incoming>l2_access_Flow_2</bpmn:incoming>
      <bpmn:outgoing>l2_access_Flow_3</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:endEvent id="l2_access_end0" name="Aksi selesai / hasil diterima">
      <bpmn:incoming>l2_access_Flow_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:callActivity id="l2_access_call1" name="Undang pengguna" calledElement="c1:Process_l3_invite">
      <bpmn:incoming>l2_access_Flow_4</bpmn:incoming>
      <bpmn:outgoing>l2_access_Flow_5</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:endEvent id="l2_access_end1" name="Aksi selesai / hasil diterima">
      <bpmn:incoming>l2_access_Flow_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:callActivity id="l2_access_call2" name="Tandai token dibagikan" calledElement="c2:Process_l3_token_share">
      <bpmn:incoming>l2_access_Flow_6</bpmn:incoming>
