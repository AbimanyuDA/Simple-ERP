      <bpmn:incoming>l2_access_Flow_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:callActivity id="l2_access_call6" name="Cabut token" calledElement="c6:Process_l3_token_revoke">
      <bpmn:incoming>l2_access_Flow_14</bpmn:incoming>
