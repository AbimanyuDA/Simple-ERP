          <dc:Bounds x="1065" y="214" width="148" height="45"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="l2_platform_call1_di" bpmnElement="l2_platform_call1">
        <dc:Bounds x="850" y="300" width="178" height="90"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="l2_platform_end1_di" bpmnElement="l2_platform_end1">
        <dc:Bounds x="1120" y="326" width="38" height="38"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1065" y="369" width="148" height="45"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="l2_platform_Flow_0_di" bpmnElement="l2_platform_Flow_0">
        <di:waypoint x="238" y="295.0"/>
        <di:waypoint x="274.0" y="295.0"/>
        <di:waypoint x="274.0" y="295.0"/>
        <di:waypoint x="310" y="295.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="l2_platform_Flow_1_di" bpmnElement="l2_platform_Flow_1">
        <di:waypoint x="488" y="295.0"/>
        <di:waypoint x="519.0" y="295.0"/>
        <di:waypoint x="519.0" y="295.0"/>
        <di:waypoint x="550" y="295.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="l2_platform_Flow_2_di" bpmnElement="l2_platform_Flow_2">
        <di:waypoint x="604" y="295.0"/>
        <di:waypoint x="645" y="295.0"/>
        <di:waypoint x="645" y="190.0"/>
        <di:waypoint x="850" y="190.0"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="680" y="135.0" width="150" height="45"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="l2_platform_Flow_3_di" bpmnElement="l2_platform_Flow_3">
        <di:waypoint x="1028" y="190.0"/>
        <di:waypoint x="1074.0" y="190.0"/>
        <di:waypoint x="1074.0" y="190.0"/>
        <di:waypoint x="1120" y="190.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="l2_platform_Flow_4_di" bpmnElement="l2_platform_Flow_4">
        <di:waypoint x="604" y="295.0"/>
