<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:tns="https://simple-erp.local/bpm-haqi/l2-platform" xmlns:c0="https://simple-erp.local/bpm-haqi/l3-kontrol-request" xmlns:c1="https://simple-erp.local/bpm-haqi/l3-health" id="Definitions_l2_platform" targetNamespace="https://simple-erp.local/bpm-haqi/l2-platform" exporter="Simple ERP source-backed documentation" exporterVersion="1">
  <bpmn:import namespace="https://simple-erp.local/bpm-haqi/l3-kontrol-request" location="../level-3/l3-kontrol-request.bpmn" importType="http://www.omg.org/spec/BPMN/20100524/MODEL"/>
  <bpmn:import namespace="https://simple-erp.local/bpm-haqi/l3-health" location="../level-3/l3-health.bpmn" importType="http://www.omg.org/spec/BPMN/20100524/MODEL"/>
  <bpmn:process id="Process_l2_platform" name="Kontrol request dan health" isExecutable="false">
    <bpmn:documentation>Level 2; source snapshot 2026-10-21; descriptive as-is working tree, not deployed-runtime proof.</bpmn:documentation>
    <bpmn:laneSet id="Lanes_l2_platform">
      <bpmn:lane id="Lane_l2_platform_0" name="Pemilik kebutuhan (role pada detail)">
        <bpmn:flowNodeRef>l2_platform_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l2_platform_choose</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l2_platform_branch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l2_platform_call0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l2_platform_end0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l2_platform_call1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l2_platform_end1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="l2_platform_start" name="Kebutuhan muncul">
      <bpmn:outgoing>l2_platform_Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="l2_platform_choose" name="Pilih kebutuhan">
      <bpmn:incoming>l2_platform_Flow_0</bpmn:incoming>
      <bpmn:outgoing>l2_platform_Flow_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="l2_platform_branch" name="Kebutuhan apa?" default="l2_platform_Flow_4" gatewayDirection="Diverging">
      <bpmn:incoming>l2_platform_Flow_1</bpmn:incoming>
      <bpmn:outgoing>l2_platform_Flow_2</bpmn:outgoing>
      <bpmn:outgoing>l2_platform_Flow_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="l2_platform_call0" name="Kontrol route terproteksi" calledElement="c0:Process_l3_kontrol_request">
      <bpmn:incoming>l2_platform_Flow_2</bpmn:incoming>
      <bpmn:outgoing>l2_platform_Flow_3</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:endEvent id="l2_platform_end0" name="Aksi selesai / hasil diterima">
      <bpmn:incoming>l2_platform_Flow_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:callActivity id="l2_platform_call1" name="Health endpoint publik" calledElement="c1:Process_l3_health">
      <bpmn:incoming>l2_platform_Flow_4</bpmn:incoming>
      <bpmn:outgoing>l2_platform_Flow_5</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:endEvent id="l2_platform_end1" name="Aksi selesai / hasil diterima">
      <bpmn:incoming>l2_platform_Flow_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="l2_platform_Flow_0" sourceRef="l2_platform_start" targetRef="l2_platform_choose"/>
    <bpmn:sequenceFlow id="l2_platform_Flow_1" sourceRef="l2_platform_choose" targetRef="l2_platform_branch"/>
    <bpmn:sequenceFlow id="l2_platform_Flow_2" sourceRef="l2_platform_branch" targetRef="l2_platform_call0" name="Kontrol route terproteksi">
      <bpmn:conditionExpression language="text/plain" xsi:type="bpmn:tFormalExpression">Kontrol route terproteksi</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="l2_platform_Flow_3" sourceRef="l2_platform_call0" targetRef="l2_platform_end0"/>
    <bpmn:sequenceFlow id="l2_platform_Flow_4" sourceRef="l2_platform_branch" targetRef="l2_platform_call1" name="Health endpoint publik"/>
    <bpmn:sequenceFlow id="l2_platform_Flow_5" sourceRef="l2_platform_call1" targetRef="l2_platform_end1"/>
  </bpmn:process>
  <bpmn:collaboration id="Collab_l2_platform">
    <bpmn:participant id="Pool_l2_platform" name="Simple ERP" processRef="Process_l2_platform"/>
  </bpmn:collaboration>
  <bpmndi:BPMNDiagram id="Diagram_l2_platform">
    <bpmndi:BPMNPlane id="Plane_l2_platform" bpmnElement="Collab_l2_platform">
      <bpmndi:BPMNShape id="Pool_l2_platform_di" bpmnElement="Pool_l2_platform" isHorizontal="true">
        <dc:Bounds x="20" y="100" width="1280" height="390"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_l2_platform_0_di" bpmnElement="Lane_l2_platform_0" isHorizontal="true">
        <dc:Bounds x="50" y="100.0" width="1250" height="390.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="l2_platform_start_di" bpmnElement="l2_platform_start">
