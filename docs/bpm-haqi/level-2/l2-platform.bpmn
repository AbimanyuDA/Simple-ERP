          <dc:Bounds x="495" y="327.0" width="164" height="45"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="l2_platform_call0_di" bpmnElement="l2_platform_call0">
