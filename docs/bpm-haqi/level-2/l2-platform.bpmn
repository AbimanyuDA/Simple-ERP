        <di:waypoint x="645" y="345.0"/>
        <di:waypoint x="850" y="345.0"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="680" y="290.0" width="150" height="45"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="l2_platform_Flow_5_di" bpmnElement="l2_platform_Flow_5">
        <di:waypoint x="1028" y="345.0"/>
        <di:waypoint x="1074.0" y="345.0"/>
        <di:waypoint x="1074.0" y="345.0"/>
        <di:waypoint x="1120" y="345.0"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
