<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:tns="https://simple-erp.local/bpm-haqi/l2-adjustment" xmlns:c0="https://simple-erp.local/bpm-haqi/l3-adj-create" xmlns:c1="https://simple-erp.local/bpm-haqi/l3-adj-submit" xmlns:c2="https://simple-erp.local/bpm-haqi/l3-adj-review" xmlns:c3="https://simple-erp.local/bpm-haqi/l3-adj-post" id="Definitions_l2_adjustment" targetNamespace="https://simple-erp.local/bpm-haqi/l2-adjustment" exporter="Simple ERP source-backed documentation" exporterVersion="1">
  <bpmn:import namespace="https://simple-erp.local/bpm-haqi/l3-adj-create" location="../level-3/l3-adj-create.bpmn" importType="http://www.omg.org/spec/BPMN/20100524/MODEL"/>
  <bpmn:import namespace="https://simple-erp.local/bpm-haqi/l3-adj-submit" location="../level-3/l3-adj-submit.bpmn" importType="http://www.omg.org/spec/BPMN/20100524/MODEL"/>
  <bpmn:import namespace="https://simple-erp.local/bpm-haqi/l3-adj-review" location="../level-3/l3-adj-review.bpmn" importType="http://www.omg.org/spec/BPMN/20100524/MODEL"/>
  <bpmn:import namespace="https://simple-erp.local/bpm-haqi/l3-adj-post" location="../level-3/l3-adj-post.bpmn" importType="http://www.omg.org/spec/BPMN/20100524/MODEL"/>
  <bpmn:process id="Process_l2_adjustment" name="Stock adjustment dengan review terpisah" isExecutable="false">
    <bpmn:documentation>Level 2; source snapshot 2026-10-21; descriptive as-is working tree, not deployed-runtime proof.
Review dan posting gagal bila snapshot tidak sama. Bila sudah APPROVED, creator dapat cancel dengan alasan lalu membuat draft baru dan meminta approval ulang; tidak ada refresh snapshot otomatis.
backend/internal/inventory/adapter/postgres/store.go :: CreateAdjustment / TransitionAdjustment / PostAdjustment</bpmn:documentation>
    <bpmn:laneSet id="Lanes_l2_adjustment">
      <bpmn:lane id="Lane_l2_adjustment_0" name="Staff atau Super Admin">
        <bpmn:flowNodeRef>l2_adjustment_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l2_adjustment_stage0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l2_adjustment_stage1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l2_adjustment_stage3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_l2_adjustment_1" name="Sistem Simple ERP">
        <bpmn:flowNodeRef>l2_adjustment_gate0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l2_adjustment_exit0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l2_adjustment_gate1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l2_adjustment_exit1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l2_adjustment_gate2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l2_adjustment_exit2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l2_adjustment_gate3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l2_adjustment_exit3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l2_adjustment_end</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l2_adjustment_rejected</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_l2_adjustment_2" name="Supervisor atau Super Admin">
        <bpmn:flowNodeRef>l2_adjustment_stage2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="l2_adjustment_start" name="Kebutuhan dokumen">
      <bpmn:outgoing>l2_adjustment_Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:callActivity id="l2_adjustment_stage0" name="Catat hasil hitung dan snapshot" calledElement="c0:Process_l3_adj_create">
      <bpmn:incoming>l2_adjustment_Flow_0</bpmn:incoming>
      <bpmn:outgoing>l2_adjustment_Flow_1</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="l2_adjustment_gate0" name="Adjustment DRAFT?" default="l2_adjustment_Flow_2" gatewayDirection="Diverging">
      <bpmn:incoming>l2_adjustment_Flow_1</bpmn:incoming>
      <bpmn:outgoing>l2_adjustment_Flow_2</bpmn:outgoing>
      <bpmn:outgoing>l2_adjustment_Flow_3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="l2_adjustment_exit0" name="Belum lanjut; periksa hasil aksi">
      <bpmn:incoming>l2_adjustment_Flow_2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:callActivity id="l2_adjustment_stage1" name="Submit adjustment" calledElement="c1:Process_l3_adj_submit">
      <bpmn:incoming>l2_adjustment_Flow_3</bpmn:incoming>
      <bpmn:outgoing>l2_adjustment_Flow_4</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="l2_adjustment_gate1" name="Adjustment SUBMITTED?" default="l2_adjustment_Flow_5" gatewayDirection="Diverging">
      <bpmn:incoming>l2_adjustment_Flow_4</bpmn:incoming>
      <bpmn:outgoing>l2_adjustment_Flow_5</bpmn:outgoing>
      <bpmn:outgoing>l2_adjustment_Flow_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="l2_adjustment_exit1" name="Belum lanjut; periksa hasil aksi">
      <bpmn:incoming>l2_adjustment_Flow_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:callActivity id="l2_adjustment_stage2" name="Review dan cek snapshot" calledElement="c2:Process_l3_adj_review">
      <bpmn:incoming>l2_adjustment_Flow_6</bpmn:incoming>
      <bpmn:outgoing>l2_adjustment_Flow_7</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="l2_adjustment_gate2" name="Hasil review?" default="l2_adjustment_Flow_13" gatewayDirection="Diverging">
      <bpmn:incoming>l2_adjustment_Flow_7</bpmn:incoming>
      <bpmn:outgoing>l2_adjustment_Flow_11</bpmn:outgoing>
      <bpmn:outgoing>l2_adjustment_Flow_12</bpmn:outgoing>
      <bpmn:outgoing>l2_adjustment_Flow_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="l2_adjustment_exit2" name="Belum lanjut; periksa hasil aksi">
      <bpmn:incoming>l2_adjustment_Flow_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:callActivity id="l2_adjustment_stage3" name="Post selisih" calledElement="c3:Process_l3_adj_post">
      <bpmn:incoming>l2_adjustment_Flow_12</bpmn:incoming>
      <bpmn:outgoing>l2_adjustment_Flow_8</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="l2_adjustment_gate3" name="Adjustment COMPLETED?" default="l2_adjustment_Flow_9" gatewayDirection="Diverging">
      <bpmn:incoming>l2_adjustment_Flow_8</bpmn:incoming>
      <bpmn:outgoing>l2_adjustment_Flow_9</bpmn:outgoing>
      <bpmn:outgoing>l2_adjustment_Flow_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="l2_adjustment_exit3" name="Belum lanjut; periksa hasil aksi">
      <bpmn:incoming>l2_adjustment_Flow_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="l2_adjustment_end" name="Tahap selesai">
      <bpmn:incoming>l2_adjustment_Flow_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="l2_adjustment_rejected" name="Adjustment REJECTED">
      <bpmn:incoming>l2_adjustment_Flow_11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="l2_adjustment_Flow_0" sourceRef="l2_adjustment_start" targetRef="l2_adjustment_stage0"/>
    <bpmn:sequenceFlow id="l2_adjustment_Flow_1" sourceRef="l2_adjustment_stage0" targetRef="l2_adjustment_gate0"/>
    <bpmn:sequenceFlow id="l2_adjustment_Flow_2" sourceRef="l2_adjustment_gate0" targetRef="l2_adjustment_exit0" name="Tidak"/>
    <bpmn:sequenceFlow id="l2_adjustment_Flow_3" sourceRef="l2_adjustment_gate0" targetRef="l2_adjustment_stage1" name="Ya">
      <bpmn:conditionExpression language="text/plain" xsi:type="bpmn:tFormalExpression">Ya</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="l2_adjustment_Flow_4" sourceRef="l2_adjustment_stage1" targetRef="l2_adjustment_gate1"/>
    <bpmn:sequenceFlow id="l2_adjustment_Flow_5" sourceRef="l2_adjustment_gate1" targetRef="l2_adjustment_exit1" name="Tidak"/>
    <bpmn:sequenceFlow id="l2_adjustment_Flow_6" sourceRef="l2_adjustment_gate1" targetRef="l2_adjustment_stage2" name="Ya">
      <bpmn:conditionExpression language="text/plain" xsi:type="bpmn:tFormalExpression">Ya</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="l2_adjustment_Flow_7" sourceRef="l2_adjustment_stage2" targetRef="l2_adjustment_gate2"/>
    <bpmn:sequenceFlow id="l2_adjustment_Flow_8" sourceRef="l2_adjustment_stage3" targetRef="l2_adjustment_gate3"/>
    <bpmn:sequenceFlow id="l2_adjustment_Flow_9" sourceRef="l2_adjustment_gate3" targetRef="l2_adjustment_exit3" name="Tidak"/>
    <bpmn:sequenceFlow id="l2_adjustment_Flow_10" sourceRef="l2_adjustment_gate3" targetRef="l2_adjustment_end" name="Ya">
      <bpmn:conditionExpression language="text/plain" xsi:type="bpmn:tFormalExpression">Ya</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="l2_adjustment_Flow_11" sourceRef="l2_adjustment_gate2" targetRef="l2_adjustment_rejected" name="Adjustment REJECTED">
      <bpmn:conditionExpression language="text/plain" xsi:type="bpmn:tFormalExpression">Adjustment REJECTED</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="l2_adjustment_Flow_12" sourceRef="l2_adjustment_gate2" targetRef="l2_adjustment_stage3" name="APPROVED">
      <bpmn:conditionExpression language="text/plain" xsi:type="bpmn:tFormalExpression">APPROVED</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="l2_adjustment_Flow_13" sourceRef="l2_adjustment_gate2" targetRef="l2_adjustment_exit2" name="Review gagal"/>
  </bpmn:process>
  <bpmn:collaboration id="Collab_l2_adjustment">
    <bpmn:participant id="Pool_l2_adjustment" name="Simple ERP" processRef="Process_l2_adjustment"/>
