<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:tns="https://simple-erp.local/bpm-haqi/l2-so" xmlns:c0="https://simple-erp.local/bpm-haqi/l3-so-create" xmlns:c1="https://simple-erp.local/bpm-haqi/l3-so-submit" xmlns:c2="https://simple-erp.local/bpm-haqi/l3-so-review" xmlns:c3="https://simple-erp.local/bpm-haqi/l3-so-confirm" id="Definitions_l2_so" targetNamespace="https://simple-erp.local/bpm-haqi/l2-so" exporter="Simple ERP source-backed documentation" exporterVersion="1">
  <bpmn:import namespace="https://simple-erp.local/bpm-haqi/l3-so-create" location="../level-3/l3-so-create.bpmn" importType="http://www.omg.org/spec/BPMN/20100524/MODEL"/>
  <bpmn:import namespace="https://simple-erp.local/bpm-haqi/l3-so-submit" location="../level-3/l3-so-submit.bpmn" importType="http://www.omg.org/spec/BPMN/20100524/MODEL"/>
  <bpmn:import namespace="https://simple-erp.local/bpm-haqi/l3-so-review" location="../level-3/l3-so-review.bpmn" importType="http://www.omg.org/spec/BPMN/20100524/MODEL"/>
  <bpmn:import namespace="https://simple-erp.local/bpm-haqi/l3-so-confirm" location="../level-3/l3-so-confirm.bpmn" importType="http://www.omg.org/spec/BPMN/20100524/MODEL"/>
  <bpmn:process id="Process_l2_so" name="Sales Order dari draft sampai konfirmasi" isExecutable="false">
    <bpmn:documentation>Level 2; source snapshot 2026-10-21; descriptive as-is working tree, not deployed-runtime proof.
Edit dan validasi stok manual tersedia melalui l2-sales-correction. Submit/approve juga memeriksa stok.
backend/internal/sales/adapter/postgres/store.go :: CreateOrder / TransitionOrder</bpmn:documentation>
    <bpmn:laneSet id="Lanes_l2_so">
      <bpmn:lane id="Lane_l2_so_0" name="Staff atau Super Admin">
        <bpmn:flowNodeRef>l2_so_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l2_so_stage0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l2_so_stage1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l2_so_stage3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_l2_so_1" name="Sistem Simple ERP">
        <bpmn:flowNodeRef>l2_so_gate0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l2_so_exit0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l2_so_gate1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l2_so_exit1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l2_so_gate2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l2_so_exit2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l2_so_gate3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l2_so_exit3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l2_so_end</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l2_so_rejected</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_l2_so_2" name="Supervisor atau Super Admin">
        <bpmn:flowNodeRef>l2_so_stage2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="l2_so_start" name="Kebutuhan dokumen">
      <bpmn:outgoing>l2_so_Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:callActivity id="l2_so_stage0" name="Buat SO" calledElement="c0:Process_l3_so_create">
      <bpmn:incoming>l2_so_Flow_0</bpmn:incoming>
      <bpmn:outgoing>l2_so_Flow_1</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="l2_so_gate0" name="SO DRAFT berhasil?" default="l2_so_Flow_2" gatewayDirection="Diverging">
      <bpmn:incoming>l2_so_Flow_1</bpmn:incoming>
      <bpmn:outgoing>l2_so_Flow_2</bpmn:outgoing>
      <bpmn:outgoing>l2_so_Flow_3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="l2_so_exit0" name="Belum lanjut; periksa hasil aksi">
      <bpmn:incoming>l2_so_Flow_2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:callActivity id="l2_so_stage1" name="Submit dan cek stok" calledElement="c1:Process_l3_so_submit">
      <bpmn:incoming>l2_so_Flow_3</bpmn:incoming>
      <bpmn:outgoing>l2_so_Flow_4</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="l2_so_gate1" name="SO SUBMITTED?" default="l2_so_Flow_5" gatewayDirection="Diverging">
      <bpmn:incoming>l2_so_Flow_4</bpmn:incoming>
      <bpmn:outgoing>l2_so_Flow_5</bpmn:outgoing>
      <bpmn:outgoing>l2_so_Flow_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="l2_so_exit1" name="Belum lanjut; periksa hasil aksi">
      <bpmn:incoming>l2_so_Flow_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:callActivity id="l2_so_stage2" name="Review SO" calledElement="c2:Process_l3_so_review">
      <bpmn:incoming>l2_so_Flow_6</bpmn:incoming>
      <bpmn:outgoing>l2_so_Flow_7</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="l2_so_gate2" name="Hasil review?" default="l2_so_Flow_13" gatewayDirection="Diverging">
      <bpmn:incoming>l2_so_Flow_7</bpmn:incoming>
      <bpmn:outgoing>l2_so_Flow_11</bpmn:outgoing>
      <bpmn:outgoing>l2_so_Flow_12</bpmn:outgoing>
      <bpmn:outgoing>l2_so_Flow_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="l2_so_exit2" name="Belum lanjut; periksa hasil aksi">
      <bpmn:incoming>l2_so_Flow_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:callActivity id="l2_so_stage3" name="Confirm SO" calledElement="c3:Process_l3_so_confirm">
      <bpmn:incoming>l2_so_Flow_12</bpmn:incoming>
      <bpmn:outgoing>l2_so_Flow_8</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="l2_so_gate3" name="confirmed_at terisi?" default="l2_so_Flow_9" gatewayDirection="Diverging">
      <bpmn:incoming>l2_so_Flow_8</bpmn:incoming>
      <bpmn:outgoing>l2_so_Flow_9</bpmn:outgoing>
      <bpmn:outgoing>l2_so_Flow_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="l2_so_exit3" name="Belum lanjut; periksa hasil aksi">
      <bpmn:incoming>l2_so_Flow_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="l2_so_end" name="Tahap selesai">
      <bpmn:incoming>l2_so_Flow_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="l2_so_rejected" name="SO REJECTED">
      <bpmn:incoming>l2_so_Flow_11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="l2_so_Flow_0" sourceRef="l2_so_start" targetRef="l2_so_stage0"/>
    <bpmn:sequenceFlow id="l2_so_Flow_1" sourceRef="l2_so_stage0" targetRef="l2_so_gate0"/>
    <bpmn:sequenceFlow id="l2_so_Flow_2" sourceRef="l2_so_gate0" targetRef="l2_so_exit0" name="Tidak"/>
    <bpmn:sequenceFlow id="l2_so_Flow_3" sourceRef="l2_so_gate0" targetRef="l2_so_stage1" name="Ya">
      <bpmn:conditionExpression language="text/plain" xsi:type="bpmn:tFormalExpression">Ya</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="l2_so_Flow_4" sourceRef="l2_so_stage1" targetRef="l2_so_gate1"/>
    <bpmn:sequenceFlow id="l2_so_Flow_5" sourceRef="l2_so_gate1" targetRef="l2_so_exit1" name="Tidak"/>
    <bpmn:sequenceFlow id="l2_so_Flow_6" sourceRef="l2_so_gate1" targetRef="l2_so_stage2" name="Ya">
      <bpmn:conditionExpression language="text/plain" xsi:type="bpmn:tFormalExpression">Ya</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="l2_so_Flow_7" sourceRef="l2_so_stage2" targetRef="l2_so_gate2"/>
    <bpmn:sequenceFlow id="l2_so_Flow_8" sourceRef="l2_so_stage3" targetRef="l2_so_gate3"/>
    <bpmn:sequenceFlow id="l2_so_Flow_9" sourceRef="l2_so_gate3" targetRef="l2_so_exit3" name="Tidak"/>
    <bpmn:sequenceFlow id="l2_so_Flow_10" sourceRef="l2_so_gate3" targetRef="l2_so_end" name="Ya">
      <bpmn:conditionExpression language="text/plain" xsi:type="bpmn:tFormalExpression">Ya</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="l2_so_Flow_11" sourceRef="l2_so_gate2" targetRef="l2_so_rejected" name="SO REJECTED">
      <bpmn:conditionExpression language="text/plain" xsi:type="bpmn:tFormalExpression">SO REJECTED</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="l2_so_Flow_12" sourceRef="l2_so_gate2" targetRef="l2_so_stage3" name="APPROVED">
      <bpmn:conditionExpression language="text/plain" xsi:type="bpmn:tFormalExpression">APPROVED</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="l2_so_Flow_13" sourceRef="l2_so_gate2" targetRef="l2_so_exit2" name="Review gagal"/>
  </bpmn:process>
