      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="l2_delivery_gate1_di" bpmnElement="l2_delivery_gate1">
        <dc:Bounds x="995" y="473.0" width="54" height="54"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="940" y="532.0" width="164" height="45"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="l2_delivery_exit1_di" bpmnElement="l2_delivery_exit1">
