<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:tns="https://simple-erp.local/bpm-haqi/l2-delivery" xmlns:c0="https://simple-erp.local/bpm-haqi/l3-delivery-create" xmlns:c1="https://simple-erp.local/bpm-haqi/l3-delivery-post" id="Definitions_l2_delivery" targetNamespace="https://simple-erp.local/bpm-haqi/l2-delivery" exporter="Simple ERP source-backed documentation" exporterVersion="1">
  <bpmn:import namespace="https://simple-erp.local/bpm-haqi/l3-delivery-create" location="../level-3/l3-delivery-create.bpmn" importType="http://www.omg.org/spec/BPMN/20100524/MODEL"/>
  <bpmn:import namespace="https://simple-erp.local/bpm-haqi/l3-delivery-post" location="../level-3/l3-delivery-post.bpmn" importType="http://www.omg.org/spec/BPMN/20100524/MODEL"/>
  <bpmn:process id="Process_l2_delivery" name="Pengiriman barang dan pencatatan stok keluar" isExecutable="false">
    <bpmn:documentation>Level 2; source snapshot 2026-10-21; descriptive as-is working tree, not deployed-runtime proof.
Ulangi untuk sisa bila SO PARTIALLY_DELIVERED. Invoice hanya setelah SO DELIVERED.
backend/internal/sales/adapter/postgres/store.go :: CreateDelivery / PostDelivery</bpmn:documentation>
    <bpmn:laneSet id="Lanes_l2_delivery">
      <bpmn:lane id="Lane_l2_delivery_0" name="Staff atau Super Admin">
        <bpmn:flowNodeRef>l2_delivery_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l2_delivery_stage0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l2_delivery_stage1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_l2_delivery_1" name="Sistem Simple ERP">
        <bpmn:flowNodeRef>l2_delivery_gate0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l2_delivery_exit0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l2_delivery_gate1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l2_delivery_exit1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l2_delivery_end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="l2_delivery_start" name="Kebutuhan dokumen">
      <bpmn:outgoing>l2_delivery_Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:callActivity id="l2_delivery_stage0" name="Buat delivery untuk SO confirmed" calledElement="c0:Process_l3_delivery_create">
      <bpmn:incoming>l2_delivery_Flow_0</bpmn:incoming>
      <bpmn:incoming>l2_delivery_Flow_6</bpmn:incoming>
      <bpmn:outgoing>l2_delivery_Flow_1</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="l2_delivery_gate0" name="Delivery DRAFT?" default="l2_delivery_Flow_2" gatewayDirection="Diverging">
      <bpmn:incoming>l2_delivery_Flow_1</bpmn:incoming>
      <bpmn:outgoing>l2_delivery_Flow_2</bpmn:outgoing>
      <bpmn:outgoing>l2_delivery_Flow_3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="l2_delivery_exit0" name="Belum lanjut; periksa hasil aksi">
      <bpmn:incoming>l2_delivery_Flow_2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:callActivity id="l2_delivery_stage1" name="Post delivery" calledElement="c1:Process_l3_delivery_post">
      <bpmn:incoming>l2_delivery_Flow_3</bpmn:incoming>
      <bpmn:outgoing>l2_delivery_Flow_4</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="l2_delivery_gate1" name="Hasil posting delivery dan SO?" default="l2_delivery_Flow_7" gatewayDirection="Diverging">
      <bpmn:incoming>l2_delivery_Flow_4</bpmn:incoming>
      <bpmn:outgoing>l2_delivery_Flow_5</bpmn:outgoing>
      <bpmn:outgoing>l2_delivery_Flow_6</bpmn:outgoing>
      <bpmn:outgoing>l2_delivery_Flow_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="l2_delivery_exit1" name="Belum lanjut; periksa hasil aksi">
      <bpmn:incoming>l2_delivery_Flow_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="l2_delivery_end" name="Tahap selesai">
      <bpmn:incoming>l2_delivery_Flow_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="l2_delivery_Flow_0" sourceRef="l2_delivery_start" targetRef="l2_delivery_stage0"/>
    <bpmn:sequenceFlow id="l2_delivery_Flow_1" sourceRef="l2_delivery_stage0" targetRef="l2_delivery_gate0"/>
    <bpmn:sequenceFlow id="l2_delivery_Flow_2" sourceRef="l2_delivery_gate0" targetRef="l2_delivery_exit0" name="Tidak"/>
    <bpmn:sequenceFlow id="l2_delivery_Flow_3" sourceRef="l2_delivery_gate0" targetRef="l2_delivery_stage1" name="Ya">
      <bpmn:conditionExpression language="text/plain" xsi:type="bpmn:tFormalExpression">Ya</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="l2_delivery_Flow_4" sourceRef="l2_delivery_stage1" targetRef="l2_delivery_gate1"/>
    <bpmn:sequenceFlow id="l2_delivery_Flow_5" sourceRef="l2_delivery_gate1" targetRef="l2_delivery_end" name="SO DELIVERED">
      <bpmn:conditionExpression language="text/plain" xsi:type="bpmn:tFormalExpression">SO DELIVERED</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="l2_delivery_Flow_6" sourceRef="l2_delivery_gate1" targetRef="l2_delivery_stage0" name="SO PARTIALLY_DELIVERED">
      <bpmn:conditionExpression language="text/plain" xsi:type="bpmn:tFormalExpression">SO PARTIALLY_DELIVERED</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="l2_delivery_Flow_7" sourceRef="l2_delivery_gate1" targetRef="l2_delivery_exit1" name="Delivery tidak POSTED"/>
  </bpmn:process>
  <bpmn:collaboration id="Collab_l2_delivery">
    <bpmn:participant id="Pool_l2_delivery" name="Simple ERP" processRef="Process_l2_delivery"/>
  </bpmn:collaboration>
  <bpmndi:BPMNDiagram id="Diagram_l2_delivery">
    <bpmndi:BPMNPlane id="Plane_l2_delivery" bpmnElement="Collab_l2_delivery">
      <bpmndi:BPMNShape id="Pool_l2_delivery_di" bpmnElement="Pool_l2_delivery" isHorizontal="true">
        <dc:Bounds x="20" y="100" width="1510" height="690"/>
