      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_l2_delivery_1_di" bpmnElement="Lane_l2_delivery_1" isHorizontal="true">
        <dc:Bounds x="50" y="445.0" width="1480" height="345.0"/>
      </bpmndi:BPMNShape>
