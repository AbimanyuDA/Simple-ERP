          <dc:Bounds x="1090" y="639.0" width="148" height="45"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="l2_delivery_end_di" bpmnElement="l2_delivery_end">
        <dc:Bounds x="1240" y="481.0" width="38" height="38"/>
