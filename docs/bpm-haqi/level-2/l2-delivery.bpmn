          <dc:Bounds x="1185" y="524.0" width="148" height="45"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="l2_delivery_Flow_0_di" bpmnElement="l2_delivery_Flow_0">
        <di:waypoint x="123" y="200.0"/>
        <di:waypoint x="161.5" y="200.0"/>
        <di:waypoint x="161.5" y="200.0"/>
        <di:waypoint x="200" y="200.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="l2_delivery_Flow_1_di" bpmnElement="l2_delivery_Flow_1">
