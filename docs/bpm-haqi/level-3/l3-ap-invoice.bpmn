<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:tns="https://simple-erp.local/bpm-haqi/l3-ap-invoice" id="Definitions_l3_ap_invoice" targetNamespace="https://simple-erp.local/bpm-haqi/l3-ap-invoice" exporter="Simple ERP source-backed documentation" exporterVersion="1">
  <bpmn:process id="Process_l3_ap_invoice" name="Catat invoice supplier" isExecutable="false">
    <bpmn:documentation>Level 3; source snapshot 2026-10-21; descriptive as-is working tree, not deployed-runtime proof.
Hanya PO diterima penuh. Supervisor melakukan match setelah Staff membuat invoice.
backend/internal/finance/adapter/postgres/store.go :: CreateSupplierInvoice</bpmn:documentation>
    <bpmn:laneSet id="Lanes_l3_ap_invoice">
      <bpmn:lane id="Lane_l3_ap_invoice_0" name="Staff atau Super Admin">
        <bpmn:flowNodeRef>l3_ap_invoice_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l3_ap_invoice_input</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_l3_ap_invoice_1" name="Sistem Simple ERP">
        <bpmn:flowNodeRef>l3_ap_invoice_check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l3_ap_invoice_valid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l3_ap_invoice_effect0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l3_ap_invoice_effect1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l3_ap_invoice_done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l3_ap_invoice_failed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="l3_ap_invoice_start" name="Kebutuhan aksi">
      <bpmn:outgoing>l3_ap_invoice_Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="l3_ap_invoice_input" name="Isi invoice supplier dan referensi PO">
      <bpmn:documentation>Aktor alternatif pada lane, bukan dua persetujuan.</bpmn:documentation>
      <bpmn:incoming>l3_ap_invoice_Flow_0</bpmn:incoming>
      <bpmn:outgoing>l3_ap_invoice_Flow_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="l3_ap_invoice_check" name="PO RECEIVED; metadata/lines valid; aturan invoice pengganti terpenuhi">
      <bpmn:documentation>Setelah kontrol akses HTTP; lihat l3-kontrol-request. Hanya PO diterima penuh. Supervisor melakukan match setelah Staff membuat invoice.</bpmn:documentation>
      <bpmn:incoming>l3_ap_invoice_Flow_1</bpmn:incoming>
      <bpmn:outgoing>l3_ap_invoice_Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="l3_ap_invoice_valid" name="Syarat terpenuhi?" default="l3_ap_invoice_Flow_6" gatewayDirection="Diverging">
      <bpmn:incoming>l3_ap_invoice_Flow_2</bpmn:incoming>
      <bpmn:outgoing>l3_ap_invoice_Flow_3</bpmn:outgoing>
      <bpmn:outgoing>l3_ap_invoice_Flow_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="l3_ap_invoice_effect0" name="Simpan invoice MATCH_PENDING dan line invoice">
      <bpmn:incoming>l3_ap_invoice_Flow_3</bpmn:incoming>
      <bpmn:outgoing>l3_ap_invoice_Flow_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="l3_ap_invoice_effect1" name="Audit PUR-INV-001; commit">
      <bpmn:incoming>l3_ap_invoice_Flow_4</bpmn:incoming>
      <bpmn:outgoing>l3_ap_invoice_Flow_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="l3_ap_invoice_done" name="Aksi selesai; hasil diterima">
      <bpmn:incoming>l3_ap_invoice_Flow_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="l3_ap_invoice_failed" name="Ditolak / gagal; tidak commit">
      <bpmn:incoming>l3_ap_invoice_Flow_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="l3_ap_invoice_Flow_0" sourceRef="l3_ap_invoice_start" targetRef="l3_ap_invoice_input"/>
    <bpmn:sequenceFlow id="l3_ap_invoice_Flow_1" sourceRef="l3_ap_invoice_input" targetRef="l3_ap_invoice_check"/>
    <bpmn:sequenceFlow id="l3_ap_invoice_Flow_2" sourceRef="l3_ap_invoice_check" targetRef="l3_ap_invoice_valid"/>
    <bpmn:sequenceFlow id="l3_ap_invoice_Flow_3" sourceRef="l3_ap_invoice_valid" targetRef="l3_ap_invoice_effect0" name="Ya">
      <bpmn:conditionExpression language="text/plain" xsi:type="bpmn:tFormalExpression">Ya</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="l3_ap_invoice_Flow_4" sourceRef="l3_ap_invoice_effect0" targetRef="l3_ap_invoice_effect1"/>
    <bpmn:sequenceFlow id="l3_ap_invoice_Flow_5" sourceRef="l3_ap_invoice_effect1" targetRef="l3_ap_invoice_done"/>
    <bpmn:sequenceFlow id="l3_ap_invoice_Flow_6" sourceRef="l3_ap_invoice_valid" targetRef="l3_ap_invoice_failed" name="Tidak"/>
  </bpmn:process>
  <bpmn:collaboration id="Collab_l3_ap_invoice">
    <bpmn:participant id="Pool_l3_ap_invoice" name="Simple ERP" processRef="Process_l3_ap_invoice"/>
  </bpmn:collaboration>
  <bpmndi:BPMNDiagram id="Diagram_l3_ap_invoice">
    <bpmndi:BPMNPlane id="Plane_l3_ap_invoice" bpmnElement="Collab_l3_ap_invoice">
      <bpmndi:BPMNShape id="Pool_l3_ap_invoice_di" bpmnElement="Pool_l3_ap_invoice" isHorizontal="true">
        <dc:Bounds x="20" y="100" width="2020" height="440"/>
