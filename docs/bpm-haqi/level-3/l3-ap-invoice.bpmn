      <bpmndi:BPMNShape id="l3_ap_invoice_effect1_di" bpmnElement="l3_ap_invoice_effect1">
        <dc:Bounds x="1325" y="365.0" width="178" height="90"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="l3_ap_invoice_done_di" bpmnElement="l3_ap_invoice_done">
