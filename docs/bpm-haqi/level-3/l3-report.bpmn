<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:tns="https://simple-erp.local/bpm-haqi/l3-report" id="Definitions_l3_report" targetNamespace="https://simple-erp.local/bpm-haqi/l3-report" exporter="Simple ERP source-backed documentation" exporterVersion="1">
  <bpmn:process id="Process_l3_report" name="Baca laporan dan audit trail" isExecutable="false">
    <bpmn:documentation>Level 3; source snapshot 2026-10-21; descriptive as-is working tree, not deployed-runtime proof.
Laporan finansial limit 100; inventory 500; audit 200 dengan filter entity/actor/action. Tidak ada route export/PDF atau pagination.
backend/internal/reporting/adapter/postgres/store.go :: Purchases / Sales / Inventory / Payables / Receivables / Audit</bpmn:documentation>
    <bpmn:laneSet id="Lanes_l3_report">
      <bpmn:lane id="Lane_l3_report_0" name="Supervisor atau Super Admin">
        <bpmn:flowNodeRef>l3_report_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l3_report_input</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_l3_report_1" name="Sistem Simple ERP">
        <bpmn:flowNodeRef>l3_report_check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l3_report_valid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l3_report_effect0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l3_report_effect1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l3_report_done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l3_report_failed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="l3_report_start" name="Kebutuhan aksi">
      <bpmn:outgoing>l3_report_Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="l3_report_input" name="Pilih laporan atau filter audit">
      <bpmn:documentation>Aktor alternatif pada lane, bukan dua persetujuan.</bpmn:documentation>
      <bpmn:incoming>l3_report_Flow_0</bpmn:incoming>
      <bpmn:outgoing>l3_report_Flow_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="l3_report_check" name="Role Supervisor/Super Admin; query berhasil">
      <bpmn:documentation>Setelah kontrol akses HTTP; lihat l3-kontrol-request. Laporan finansial limit 100; inventory 500; audit 200 dengan filter entity/actor/action. Tidak ada route export/PDF atau pagination.</bpmn:documentation>
      <bpmn:incoming>l3_report_Flow_1</bpmn:incoming>
      <bpmn:outgoing>l3_report_Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="l3_report_valid" name="Syarat terpenuhi?" default="l3_report_Flow_6" gatewayDirection="Diverging">
      <bpmn:incoming>l3_report_Flow_2</bpmn:incoming>
      <bpmn:outgoing>l3_report_Flow_3</bpmn:outgoing>
      <bpmn:outgoing>l3_report_Flow_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="l3_report_effect0" name="Query purchases, sales, inventory, AP/AR atau audit">
      <bpmn:incoming>l3_report_Flow_3</bpmn:incoming>
      <bpmn:outgoing>l3_report_Flow_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="l3_report_effect1" name="Kirim hasil; tidak memutasi transaksi">
      <bpmn:incoming>l3_report_Flow_4</bpmn:incoming>
      <bpmn:outgoing>l3_report_Flow_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="l3_report_done" name="Aksi selesai; hasil diterima">
      <bpmn:incoming>l3_report_Flow_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="l3_report_failed" name="Ditolak / gagal; tidak commit">
      <bpmn:incoming>l3_report_Flow_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="l3_report_Flow_0" sourceRef="l3_report_start" targetRef="l3_report_input"/>
    <bpmn:sequenceFlow id="l3_report_Flow_1" sourceRef="l3_report_input" targetRef="l3_report_check"/>
    <bpmn:sequenceFlow id="l3_report_Flow_2" sourceRef="l3_report_check" targetRef="l3_report_valid"/>
    <bpmn:sequenceFlow id="l3_report_Flow_3" sourceRef="l3_report_valid" targetRef="l3_report_effect0" name="Ya">
      <bpmn:conditionExpression language="text/plain" xsi:type="bpmn:tFormalExpression">Ya</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="l3_report_Flow_4" sourceRef="l3_report_effect0" targetRef="l3_report_effect1"/>
    <bpmn:sequenceFlow id="l3_report_Flow_5" sourceRef="l3_report_effect1" targetRef="l3_report_done"/>
    <bpmn:sequenceFlow id="l3_report_Flow_6" sourceRef="l3_report_valid" targetRef="l3_report_failed" name="Tidak"/>
  </bpmn:process>
  <bpmn:collaboration id="Collab_l3_report">
    <bpmn:participant id="Pool_l3_report" name="Simple ERP" processRef="Process_l3_report"/>
  </bpmn:collaboration>
  <bpmndi:BPMNDiagram id="Diagram_l3_report">
    <bpmndi:BPMNPlane id="Plane_l3_report" bpmnElement="Collab_l3_report">
      <bpmndi:BPMNShape id="Pool_l3_report_di" bpmnElement="Pool_l3_report" isHorizontal="true">
        <dc:Bounds x="20" y="100" width="2020" height="440"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_l3_report_0_di" bpmnElement="Lane_l3_report_0" isHorizontal="true">
        <dc:Bounds x="50" y="100.0" width="1990" height="220.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_l3_report_1_di" bpmnElement="Lane_l3_report_1" isHorizontal="true">
        <dc:Bounds x="50" y="320.0" width="1990" height="220.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="l3_report_start_di" bpmnElement="l3_report_start">
        <dc:Bounds x="200" y="171.0" width="38" height="38"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="145" y="214.0" width="148" height="45"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="l3_report_input_di" bpmnElement="l3_report_input">
        <dc:Bounds x="425" y="145.0" width="178" height="90"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="l3_report_check_di" bpmnElement="l3_report_check">
        <dc:Bounds x="650" y="365.0" width="178" height="90"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="l3_report_valid_di" bpmnElement="l3_report_valid">
        <dc:Bounds x="875" y="383.0" width="54" height="54"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="820" y="442.0" width="164" height="45"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="l3_report_effect0_di" bpmnElement="l3_report_effect0">
        <dc:Bounds x="1100" y="365.0" width="178" height="90"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="l3_report_effect1_di" bpmnElement="l3_report_effect1">
        <dc:Bounds x="1325" y="365.0" width="178" height="90"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="l3_report_done_di" bpmnElement="l3_report_done">
        <dc:Bounds x="1550" y="391.0" width="38" height="38"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1495" y="434.0" width="148" height="45"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="l3_report_failed_di" bpmnElement="l3_report_failed">
        <dc:Bounds x="1775" y="391.0" width="38" height="38"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1720" y="434.0" width="148" height="45"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="l3_report_Flow_0_di" bpmnElement="l3_report_Flow_0">
        <di:waypoint x="238" y="190.0"/>
        <di:waypoint x="331.5" y="190.0"/>
        <di:waypoint x="331.5" y="190.0"/>
        <di:waypoint x="425" y="190.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="l3_report_Flow_1_di" bpmnElement="l3_report_Flow_1">
        <di:waypoint x="603" y="190.0"/>
        <di:waypoint x="626.5" y="190.0"/>
        <di:waypoint x="626.5" y="410.0"/>
        <di:waypoint x="650" y="410.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="l3_report_Flow_2_di" bpmnElement="l3_report_Flow_2">
        <di:waypoint x="828" y="410.0"/>
        <di:waypoint x="851.5" y="410.0"/>
        <di:waypoint x="851.5" y="410.0"/>
        <di:waypoint x="875" y="410.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="l3_report_Flow_3_di" bpmnElement="l3_report_Flow_3">
        <di:waypoint x="929" y="410.0"/>
        <di:waypoint x="1014.5" y="410.0"/>
        <di:waypoint x="1014.5" y="410.0"/>
        <di:waypoint x="1100" y="410.0"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="930" y="355.0" width="150" height="45"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="l3_report_Flow_4_di" bpmnElement="l3_report_Flow_4">
        <di:waypoint x="1278" y="410.0"/>
        <di:waypoint x="1301.5" y="410.0"/>
        <di:waypoint x="1301.5" y="410.0"/>
        <di:waypoint x="1325" y="410.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="l3_report_Flow_5_di" bpmnElement="l3_report_Flow_5">
        <di:waypoint x="1503" y="410.0"/>
        <di:waypoint x="1526.5" y="410.0"/>
        <di:waypoint x="1526.5" y="410.0"/>
        <di:waypoint x="1550" y="410.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="l3_report_Flow_6_di" bpmnElement="l3_report_Flow_6">
        <di:waypoint x="929" y="410.0"/>
        <di:waypoint x="947" y="410.0"/>
        <di:waypoint x="947" y="508"/>
        <di:waypoint x="1757" y="508"/>
        <di:waypoint x="1757" y="410.0"/>
        <di:waypoint x="1775" y="410.0"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1605" y="355.0" width="150" height="45"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
