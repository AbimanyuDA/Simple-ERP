<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:tns="https://simple-erp.local/bpm-haqi/l3-so-review" id="Definitions_l3_so_review" targetNamespace="https://simple-erp.local/bpm-haqi/l3-so-review" exporter="Simple ERP source-backed documentation" exporterVersion="1">
  <bpmn:process id="Process_l3_so_review" name="Review Sales Order" isExecutable="false">
    <bpmn:documentation>Level 3; source snapshot 2026-10-21; descriptive as-is working tree, not deployed-runtime proof.
Cek stok tidak mereservasi stok. Reject wajib alasan.
backend/internal/sales/adapter/postgres/store.go :: TransitionOrder</bpmn:documentation>
    <bpmn:laneSet id="Lanes_l3_so_review">
      <bpmn:lane id="Lane_l3_so_review_0" name="Supervisor atau Super Admin">
        <bpmn:flowNodeRef>l3_so_review_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l3_so_review_input</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_l3_so_review_1" name="Sistem Simple ERP">
        <bpmn:flowNodeRef>l3_so_review_check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l3_so_review_valid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l3_so_review_positive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l3_so_review_negative</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l3_so_review_effect1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l3_so_review_done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l3_so_review_failed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="l3_so_review_start" name="Kebutuhan aksi">
      <bpmn:outgoing>l3_so_review_Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="l3_so_review_input" name="Approve atau reject SO">
      <bpmn:documentation>Aktor alternatif pada lane, bukan dua persetujuan.</bpmn:documentation>
      <bpmn:incoming>l3_so_review_Flow_0</bpmn:incoming>
      <bpmn:outgoing>l3_so_review_Flow_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="l3_so_review_check" name="SUBMITTED; versi cocok; Supervisor bukan creator; Super Admin boleh self-review; approve perlu stok cukup">
      <bpmn:documentation>Setelah kontrol akses HTTP; lihat l3-kontrol-request. Cek stok tidak mereservasi stok. Reject wajib alasan.</bpmn:documentation>
      <bpmn:incoming>l3_so_review_Flow_1</bpmn:incoming>
      <bpmn:outgoing>l3_so_review_Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="l3_so_review_valid" name="Hasil review SO?" default="l3_so_review_Flow_4" gatewayDirection="Diverging">
      <bpmn:incoming>l3_so_review_Flow_2</bpmn:incoming>
      <bpmn:outgoing>l3_so_review_Flow_4</bpmn:outgoing>
      <bpmn:outgoing>l3_so_review_Flow_5</bpmn:outgoing>
      <bpmn:outgoing>l3_so_review_Flow_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="l3_so_review_positive" name="Set SO APPROVED">
      <bpmn:incoming>l3_so_review_Flow_5</bpmn:incoming>
      <bpmn:outgoing>l3_so_review_Flow_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="l3_so_review_negative" name="Set SO REJECTED dan alasan">
      <bpmn:incoming>l3_so_review_Flow_6</bpmn:incoming>
      <bpmn:outgoing>l3_so_review_Flow_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="l3_so_review_effect1" name="Simpan reviewer; audit SAL-SO-004; commit">
      <bpmn:incoming>l3_so_review_Flow_7</bpmn:incoming>
      <bpmn:incoming>l3_so_review_Flow_8</bpmn:incoming>
      <bpmn:outgoing>l3_so_review_Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="l3_so_review_done" name="Aksi selesai; hasil diterima">
      <bpmn:incoming>l3_so_review_Flow_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="l3_so_review_failed" name="Ditolak / gagal; tidak commit">
      <bpmn:incoming>l3_so_review_Flow_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="l3_so_review_Flow_0" sourceRef="l3_so_review_start" targetRef="l3_so_review_input"/>
    <bpmn:sequenceFlow id="l3_so_review_Flow_1" sourceRef="l3_so_review_input" targetRef="l3_so_review_check"/>
    <bpmn:sequenceFlow id="l3_so_review_Flow_2" sourceRef="l3_so_review_check" targetRef="l3_so_review_valid"/>
    <bpmn:sequenceFlow id="l3_so_review_Flow_3" sourceRef="l3_so_review_effect1" targetRef="l3_so_review_done"/>
    <bpmn:sequenceFlow id="l3_so_review_Flow_4" sourceRef="l3_so_review_valid" targetRef="l3_so_review_failed" name="Tidak"/>
    <bpmn:sequenceFlow id="l3_so_review_Flow_5" sourceRef="l3_so_review_valid" targetRef="l3_so_review_positive" name="Approve">
      <bpmn:conditionExpression language="text/plain" xsi:type="bpmn:tFormalExpression">Approve</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="l3_so_review_Flow_6" sourceRef="l3_so_review_valid" targetRef="l3_so_review_negative" name="Reject">
      <bpmn:conditionExpression language="text/plain" xsi:type="bpmn:tFormalExpression">Reject</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="l3_so_review_Flow_7" sourceRef="l3_so_review_positive" targetRef="l3_so_review_effect1"/>
    <bpmn:sequenceFlow id="l3_so_review_Flow_8" sourceRef="l3_so_review_negative" targetRef="l3_so_review_effect1"/>
  </bpmn:process>
  <bpmn:collaboration id="Collab_l3_so_review">
    <bpmn:participant id="Pool_l3_so_review" name="Simple ERP" processRef="Process_l3_so_review"/>
  </bpmn:collaboration>
  <bpmndi:BPMNDiagram id="Diagram_l3_so_review">
    <bpmndi:BPMNPlane id="Plane_l3_so_review" bpmnElement="Collab_l3_so_review">
      <bpmndi:BPMNShape id="Pool_l3_so_review_di" bpmnElement="Pool_l3_so_review" isHorizontal="true">
        <dc:Bounds x="20" y="100" width="2085" height="700"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_l3_so_review_0_di" bpmnElement="Lane_l3_so_review_0" isHorizontal="true">
        <dc:Bounds x="50" y="100.0" width="2055" height="350.0"/>
