      <bpmndi:BPMNShape id="Lane_l3_so_review_1_di" bpmnElement="Lane_l3_so_review_1" isHorizontal="true">
        <dc:Bounds x="50" y="450.0" width="2055" height="350.0"/>
      </bpmndi:BPMNShape>
