<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:tns="https://simple-erp.local/bpm-haqi/l3-invite" id="Definitions_l3_invite" targetNamespace="https://simple-erp.local/bpm-haqi/l3-invite" exporter="Simple ERP source-backed documentation" exporterVersion="1">
  <bpmn:process id="Process_l3_invite" name="Undang pengguna dan tetapkan role" isExecutable="false">
    <bpmn:documentation>Level 3; source snapshot 2026-10-21; descriptive as-is working tree, not deployed-runtime proof.
Role STAFF, SUPERVISOR, SUPER_ADMIN. Token digenerate sebelum store di LifecycleService. Tidak ada pengiriman email otomatis.
backend/internal/auth/adapter/postgres/lifecycle.go :: Invite</bpmn:documentation>
    <bpmn:laneSet id="Lanes_l3_invite">
      <bpmn:lane id="Lane_l3_invite_0" name="Super Admin">
        <bpmn:flowNodeRef>l3_invite_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l3_invite_input</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_l3_invite_1" name="Sistem Simple ERP">
        <bpmn:flowNodeRef>l3_invite_check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l3_invite_valid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l3_invite_effect0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l3_invite_effect1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l3_invite_done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l3_invite_failed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="l3_invite_start" name="Kebutuhan aksi">
      <bpmn:outgoing>l3_invite_Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="l3_invite_input" name="Isi nama, email, dan salah satu dari 3 role">
      <bpmn:documentation>Aktor alternatif pada lane, bukan dua persetujuan.</bpmn:documentation>
      <bpmn:incoming>l3_invite_Flow_0</bpmn:incoming>
      <bpmn:outgoing>l3_invite_Flow_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="l3_invite_check" name="Role valid; email unik; hasil insert harus berhasil">
      <bpmn:documentation>Setelah kontrol akses HTTP; lihat l3-kontrol-request. Role STAFF, SUPERVISOR, SUPER_ADMIN. Token digenerate sebelum store di LifecycleService. Tidak ada pengiriman email otomatis.</bpmn:documentation>
      <bpmn:incoming>l3_invite_Flow_1</bpmn:incoming>
      <bpmn:outgoing>l3_invite_Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="l3_invite_valid" name="Syarat terpenuhi?" default="l3_invite_Flow_6" gatewayDirection="Diverging">
      <bpmn:incoming>l3_invite_Flow_2</bpmn:incoming>
      <bpmn:outgoing>l3_invite_Flow_3</bpmn:outgoing>
      <bpmn:outgoing>l3_invite_Flow_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="l3_invite_effect0" name="Generate token 24 jam; simpan user INVITED dan hash token">
      <bpmn:incoming>l3_invite_Flow_3</bpmn:incoming>
      <bpmn:outgoing>l3_invite_Flow_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="l3_invite_effect1" name="Audit INVITE_USER; commit; tampilkan raw token sekali">
      <bpmn:incoming>l3_invite_Flow_4</bpmn:incoming>
      <bpmn:outgoing>l3_invite_Flow_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="l3_invite_done" name="Aksi selesai; hasil diterima">
      <bpmn:incoming>l3_invite_Flow_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="l3_invite_failed" name="Ditolak / gagal; tidak commit">
      <bpmn:incoming>l3_invite_Flow_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="l3_invite_Flow_0" sourceRef="l3_invite_start" targetRef="l3_invite_input"/>
    <bpmn:sequenceFlow id="l3_invite_Flow_1" sourceRef="l3_invite_input" targetRef="l3_invite_check"/>
    <bpmn:sequenceFlow id="l3_invite_Flow_2" sourceRef="l3_invite_check" targetRef="l3_invite_valid"/>
    <bpmn:sequenceFlow id="l3_invite_Flow_3" sourceRef="l3_invite_valid" targetRef="l3_invite_effect0" name="Ya">
      <bpmn:conditionExpression language="text/plain" xsi:type="bpmn:tFormalExpression">Ya</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="l3_invite_Flow_4" sourceRef="l3_invite_effect0" targetRef="l3_invite_effect1"/>
    <bpmn:sequenceFlow id="l3_invite_Flow_5" sourceRef="l3_invite_effect1" targetRef="l3_invite_done"/>
    <bpmn:sequenceFlow id="l3_invite_Flow_6" sourceRef="l3_invite_valid" targetRef="l3_invite_failed" name="Tidak"/>
  </bpmn:process>
  <bpmn:collaboration id="Collab_l3_invite">
    <bpmn:participant id="Pool_l3_invite" name="Simple ERP" processRef="Process_l3_invite"/>
  </bpmn:collaboration>
  <bpmndi:BPMNDiagram id="Diagram_l3_invite">
    <bpmndi:BPMNPlane id="Plane_l3_invite" bpmnElement="Collab_l3_invite">
      <bpmndi:BPMNShape id="Pool_l3_invite_di" bpmnElement="Pool_l3_invite" isHorizontal="true">
        <dc:Bounds x="20" y="100" width="2020" height="440"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_l3_invite_0_di" bpmnElement="Lane_l3_invite_0" isHorizontal="true">
        <dc:Bounds x="50" y="100.0" width="1990" height="220.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_l3_invite_1_di" bpmnElement="Lane_l3_invite_1" isHorizontal="true">
