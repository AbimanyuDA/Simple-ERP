      <bpmndi:BPMNShape id="l3_invite_done_di" bpmnElement="l3_invite_done">
        <dc:Bounds x="1550" y="391.0" width="38" height="38"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1495" y="434.0" width="148" height="45"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="l3_invite_failed_di" bpmnElement="l3_invite_failed">
        <dc:Bounds x="1775" y="391.0" width="38" height="38"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1720" y="434.0" width="148" height="45"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="l3_invite_Flow_0_di" bpmnElement="l3_invite_Flow_0">
        <di:waypoint x="238" y="190.0"/>
        <di:waypoint x="331.5" y="190.0"/>
        <di:waypoint x="331.5" y="190.0"/>
        <di:waypoint x="425" y="190.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="l3_invite_Flow_1_di" bpmnElement="l3_invite_Flow_1">
