        <dc:Bounds x="1100" y="365.0" width="178" height="90"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="l3_po_convert_effect1_di" bpmnElement="l3_po_convert_effect1">
        <dc:Bounds x="1325" y="365.0" width="178" height="90"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="l3_po_convert_done_di" bpmnElement="l3_po_convert_done">
        <dc:Bounds x="1550" y="391.0" width="38" height="38"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1495" y="434.0" width="148" height="45"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="l3_po_convert_failed_di" bpmnElement="l3_po_convert_failed">
        <dc:Bounds x="1775" y="391.0" width="38" height="38"/>
