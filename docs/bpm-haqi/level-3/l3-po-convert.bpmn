      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="l3_po_convert_Flow_0_di" bpmnElement="l3_po_convert_Flow_0">
        <di:waypoint x="238" y="190.0"/>
        <di:waypoint x="331.5" y="190.0"/>
        <di:waypoint x="331.5" y="190.0"/>
        <di:waypoint x="425" y="190.0"/>
      </bpmndi:BPMNEdge>
