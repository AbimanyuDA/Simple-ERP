<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:tns="https://simple-erp.local/bpm-haqi/l3-po-convert" id="Definitions_l3_po_convert" targetNamespace="https://simple-erp.local/bpm-haqi/l3-po-convert" exporter="Simple ERP source-backed documentation" exporterVersion="1">
  <bpmn:process id="Process_l3_po_convert" name="Konversi PR menjadi Purchase Order" isExecutable="false">
    <bpmn:documentation>Level 3; source snapshot 2026-10-21; descriptive as-is working tree, not deployed-runtime proof.
Tidak ada endpoint edit PO. Konversi tidak memeriksa creator PR sama dengan actor.
backend/internal/purchasing/adapter/postgres/store.go :: ConvertToOrder</bpmn:documentation>
    <bpmn:laneSet id="Lanes_l3_po_convert">
      <bpmn:lane id="Lane_l3_po_convert_0" name="Staff atau Super Admin">
        <bpmn:flowNodeRef>l3_po_convert_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l3_po_convert_input</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_l3_po_convert_1" name="Sistem Simple ERP">
        <bpmn:flowNodeRef>l3_po_convert_check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l3_po_convert_valid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l3_po_convert_effect0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l3_po_convert_effect1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l3_po_convert_done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l3_po_convert_failed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="l3_po_convert_start" name="Kebutuhan aksi">
      <bpmn:outgoing>l3_po_convert_Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="l3_po_convert_input" name="Pilih PR, supplier dan warehouse">
      <bpmn:documentation>Aktor alternatif pada lane, bukan dua persetujuan.</bpmn:documentation>
      <bpmn:incoming>l3_po_convert_Flow_0</bpmn:incoming>
      <bpmn:outgoing>l3_po_convert_Flow_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="l3_po_convert_check" name="Lock PR APPROVED; supplier dan warehouse aktif">
      <bpmn:documentation>Setelah kontrol akses HTTP; lihat l3-kontrol-request. Tidak ada endpoint edit PO. Konversi tidak memeriksa creator PR sama dengan actor.</bpmn:documentation>
      <bpmn:incoming>l3_po_convert_Flow_1</bpmn:incoming>
      <bpmn:outgoing>l3_po_convert_Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="l3_po_convert_valid" name="Syarat terpenuhi?" default="l3_po_convert_Flow_6" gatewayDirection="Diverging">
      <bpmn:incoming>l3_po_convert_Flow_2</bpmn:incoming>
      <bpmn:outgoing>l3_po_convert_Flow_3</bpmn:outgoing>
      <bpmn:outgoing>l3_po_convert_Flow_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="l3_po_convert_effect0" name="Salin PR lines ke PO DRAFT baru">
      <bpmn:incoming>l3_po_convert_Flow_3</bpmn:incoming>
      <bpmn:outgoing>l3_po_convert_Flow_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="l3_po_convert_effect1" name="PR menjadi CONVERTED_TO_PO; audit; commit">
      <bpmn:incoming>l3_po_convert_Flow_4</bpmn:incoming>
      <bpmn:outgoing>l3_po_convert_Flow_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="l3_po_convert_done" name="Aksi selesai; hasil diterima">
      <bpmn:incoming>l3_po_convert_Flow_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="l3_po_convert_failed" name="Ditolak / gagal; tidak commit">
      <bpmn:incoming>l3_po_convert_Flow_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="l3_po_convert_Flow_0" sourceRef="l3_po_convert_start" targetRef="l3_po_convert_input"/>
    <bpmn:sequenceFlow id="l3_po_convert_Flow_1" sourceRef="l3_po_convert_input" targetRef="l3_po_convert_check"/>
    <bpmn:sequenceFlow id="l3_po_convert_Flow_2" sourceRef="l3_po_convert_check" targetRef="l3_po_convert_valid"/>
    <bpmn:sequenceFlow id="l3_po_convert_Flow_3" sourceRef="l3_po_convert_valid" targetRef="l3_po_convert_effect0" name="Ya">
      <bpmn:conditionExpression language="text/plain" xsi:type="bpmn:tFormalExpression">Ya</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="l3_po_convert_Flow_4" sourceRef="l3_po_convert_effect0" targetRef="l3_po_convert_effect1"/>
    <bpmn:sequenceFlow id="l3_po_convert_Flow_5" sourceRef="l3_po_convert_effect1" targetRef="l3_po_convert_done"/>
    <bpmn:sequenceFlow id="l3_po_convert_Flow_6" sourceRef="l3_po_convert_valid" targetRef="l3_po_convert_failed" name="Tidak"/>
  </bpmn:process>
  <bpmn:collaboration id="Collab_l3_po_convert">
    <bpmn:participant id="Pool_l3_po_convert" name="Simple ERP" processRef="Process_l3_po_convert"/>
  </bpmn:collaboration>
  <bpmndi:BPMNDiagram id="Diagram_l3_po_convert">
    <bpmndi:BPMNPlane id="Plane_l3_po_convert" bpmnElement="Collab_l3_po_convert">
      <bpmndi:BPMNShape id="Pool_l3_po_convert_di" bpmnElement="Pool_l3_po_convert" isHorizontal="true">
        <dc:Bounds x="20" y="100" width="2020" height="440"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_l3_po_convert_0_di" bpmnElement="Lane_l3_po_convert_0" isHorizontal="true">
        <dc:Bounds x="50" y="100.0" width="1990" height="220.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_l3_po_convert_1_di" bpmnElement="Lane_l3_po_convert_1" isHorizontal="true">
        <dc:Bounds x="50" y="320.0" width="1990" height="220.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="l3_po_convert_start_di" bpmnElement="l3_po_convert_start">
