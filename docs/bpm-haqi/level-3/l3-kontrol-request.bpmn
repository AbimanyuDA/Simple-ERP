<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:tns="https://simple-erp.local/bpm-haqi/l3-kontrol-request" id="Definitions_l3_kontrol_request" targetNamespace="https://simple-erp.local/bpm-haqi/l3-kontrol-request" exporter="Simple ERP source-backed documentation" exporterVersion="1">
  <bpmn:process id="Process_l3_kontrol_request" name="Kontrol request, otorisasi dan idempotency" isExecutable="false">
    <bpmn:documentation>Level 3; source snapshot 2026-10-21; descriptive as-is working tree, not deployed-runtime proof.
Berlaku untuk route terproteksi. Idempotency hanya group purchasing, sales, inventory, finance, reporting. Auth/admin/master/settings di luar middleware idempotency. Role checks handler berada setelah middleware idempotency pada group operasi.
backend/cmd/api/main.go :: main
backend/internal/platform/idempotency/middleware.go :: Middleware
backend/internal/auth/adapter/http/middleware.go :: RequireAuth / RequireRole</bpmn:documentation>
    <bpmn:laneSet id="Lanes_l3_kontrol_request">
      <bpmn:lane id="Lane_l3_kontrol_request_0" name="Pengguna (semua role)">
        <bpmn:flowNodeRef>l3_kontrol_request_start</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_l3_kontrol_request_1" name="Sistem Simple ERP">
        <bpmn:flowNodeRef>l3_kontrol_request_auth</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l3_kontrol_request_authok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l3_kontrol_request_denied</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l3_kontrol_request_idem</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l3_kontrol_request_replay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l3_kontrol_request_old</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l3_kontrol_request_conflict</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l3_kontrol_request_keyerror</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l3_kontrol_request_handler</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l3_kontrol_request_result</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l3_kontrol_request_end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="l3_kontrol_request_start" name="Request HTTP">
      <bpmn:outgoing>l3_kontrol_request_Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="l3_kontrol_request_auth" name="Cek cookie, user ACTIVE, rate limit, CSRF/origin, dan tipe route">
      <bpmn:incoming>l3_kontrol_request_Flow_0</bpmn:incoming>
      <bpmn:outgoing>l3_kontrol_request_Flow_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="l3_kontrol_request_authok" name="Hasil akses dan tipe route?" default="l3_kontrol_request_Flow_2" gatewayDirection="Diverging">
      <bpmn:incoming>l3_kontrol_request_Flow_1</bpmn:incoming>
      <bpmn:outgoing>l3_kontrol_request_Flow_2</bpmn:outgoing>
      <bpmn:outgoing>l3_kontrol_request_Flow_3</bpmn:outgoing>
      <bpmn:outgoing>l3_kontrol_request_Flow_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="l3_kontrol_request_denied" name="401 / 403 / 429">
      <bpmn:incoming>l3_kontrol_request_Flow_2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="l3_kontrol_request_idem" name="Validasi key; claim hash method/path/body">
      <bpmn:incoming>l3_kontrol_request_Flow_3</bpmn:incoming>
      <bpmn:outgoing>l3_kontrol_request_Flow_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="l3_kontrol_request_replay" name="Hasil klaim key?" default="l3_kontrol_request_Flow_9" gatewayDirection="Diverging">
      <bpmn:incoming>l3_kontrol_request_Flow_5</bpmn:incoming>
      <bpmn:outgoing>l3_kontrol_request_Flow_6</bpmn:outgoing>
      <bpmn:outgoing>l3_kontrol_request_Flow_7</bpmn:outgoing>
      <bpmn:outgoing>l3_kontrol_request_Flow_8</bpmn:outgoing>
      <bpmn:outgoing>l3_kontrol_request_Flow_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="l3_kontrol_request_old" name="Replay respons tersimpan">
      <bpmn:incoming>l3_kontrol_request_Flow_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="l3_kontrol_request_conflict" name="409: key berbeda atau masih diproses">
      <bpmn:incoming>l3_kontrol_request_Flow_8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="l3_kontrol_request_keyerror" name="400 / 500: key atau claim gagal">
      <bpmn:incoming>l3_kontrol_request_Flow_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="l3_kontrol_request_handler" name="Handler cek role; validasi input; jalankan use case">
      <bpmn:incoming>l3_kontrol_request_Flow_4</bpmn:incoming>
      <bpmn:incoming>l3_kontrol_request_Flow_6</bpmn:incoming>
      <bpmn:outgoing>l3_kontrol_request_Flow_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="l3_kontrol_request_result" name="Simpan respons &lt;500; release key jika 5xx; kirim respons">
      <bpmn:incoming>l3_kontrol_request_Flow_10</bpmn:incoming>
      <bpmn:outgoing>l3_kontrol_request_Flow_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="l3_kontrol_request_end" name="Request selesai">
      <bpmn:incoming>l3_kontrol_request_Flow_11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="l3_kontrol_request_Flow_0" sourceRef="l3_kontrol_request_start" targetRef="l3_kontrol_request_auth"/>
    <bpmn:sequenceFlow id="l3_kontrol_request_Flow_1" sourceRef="l3_kontrol_request_auth" targetRef="l3_kontrol_request_authok"/>
    <bpmn:sequenceFlow id="l3_kontrol_request_Flow_2" sourceRef="l3_kontrol_request_authok" targetRef="l3_kontrol_request_denied" name="Akses ditolak"/>
    <bpmn:sequenceFlow id="l3_kontrol_request_Flow_3" sourceRef="l3_kontrol_request_authok" targetRef="l3_kontrol_request_idem" name="Mutasi group operasi">
      <bpmn:conditionExpression language="text/plain" xsi:type="bpmn:tFormalExpression">Mutasi group operasi</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="l3_kontrol_request_Flow_4" sourceRef="l3_kontrol_request_authok" targetRef="l3_kontrol_request_handler" name="Route lain">
      <bpmn:conditionExpression language="text/plain" xsi:type="bpmn:tFormalExpression">Route lain</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="l3_kontrol_request_Flow_5" sourceRef="l3_kontrol_request_idem" targetRef="l3_kontrol_request_replay"/>
    <bpmn:sequenceFlow id="l3_kontrol_request_Flow_6" sourceRef="l3_kontrol_request_replay" targetRef="l3_kontrol_request_handler" name="Key baru">
      <bpmn:conditionExpression language="text/plain" xsi:type="bpmn:tFormalExpression">Key baru</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="l3_kontrol_request_Flow_7" sourceRef="l3_kontrol_request_replay" targetRef="l3_kontrol_request_old" name="Hash sama; respons ada">
      <bpmn:conditionExpression language="text/plain" xsi:type="bpmn:tFormalExpression">Hash sama; respons ada</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="l3_kontrol_request_Flow_8" sourceRef="l3_kontrol_request_replay" targetRef="l3_kontrol_request_conflict" name="Konflik / in progress">
      <bpmn:conditionExpression language="text/plain" xsi:type="bpmn:tFormalExpression">Konflik / in progress</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="l3_kontrol_request_Flow_9" sourceRef="l3_kontrol_request_replay" targetRef="l3_kontrol_request_keyerror" name="Key / claim gagal"/>
    <bpmn:sequenceFlow id="l3_kontrol_request_Flow_10" sourceRef="l3_kontrol_request_handler" targetRef="l3_kontrol_request_result"/>
    <bpmn:sequenceFlow id="l3_kontrol_request_Flow_11" sourceRef="l3_kontrol_request_result" targetRef="l3_kontrol_request_end"/>
  </bpmn:process>
  <bpmn:collaboration id="Collab_l3_kontrol_request">
    <bpmn:participant id="Pool_l3_kontrol_request" name="Simple ERP" processRef="Process_l3_kontrol_request"/>
  </bpmn:collaboration>
