<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:tns="https://simple-erp.local/bpm-haqi/l3-ap-match" id="Definitions_l3_ap_match" targetNamespace="https://simple-erp.local/bpm-haqi/l3-ap-match" exporter="Simple ERP source-backed documentation" exporterVersion="1">
  <bpmn:process id="Process_l3_ap_match" name="Match invoice supplier" isExecutable="false">
    <bpmn:documentation>Level 3; source snapshot 2026-10-21; descriptive as-is working tree, not deployed-runtime proof.
Kode membandingkan line PO dengan invoice. Bukan query three-way match GR terpisah pada saat match; PO RECEIVED sudah disyaratkan saat create.
backend/internal/finance/adapter/postgres/store.go :: MatchSupplierInvoice</bpmn:documentation>
    <bpmn:laneSet id="Lanes_l3_ap_match">
      <bpmn:lane id="Lane_l3_ap_match_0" name="Supervisor atau Super Admin">
        <bpmn:flowNodeRef>l3_ap_match_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l3_ap_match_input</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_l3_ap_match_1" name="Sistem Simple ERP">
        <bpmn:flowNodeRef>l3_ap_match_check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l3_ap_match_valid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l3_ap_match_positive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l3_ap_match_negative</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l3_ap_match_effect1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l3_ap_match_done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l3_ap_match_failed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="l3_ap_match_start" name="Kebutuhan aksi">
      <bpmn:outgoing>l3_ap_match_Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="l3_ap_match_input" name="Pilih Match">
      <bpmn:documentation>Aktor alternatif pada lane, bukan dua persetujuan.</bpmn:documentation>
      <bpmn:incoming>l3_ap_match_Flow_0</bpmn:incoming>
      <bpmn:outgoing>l3_ap_match_Flow_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="l3_ap_match_check" name="Lock invoice MATCH_PENDING; Supervisor bukan creator; Super Admin boleh self-match; baca line PO dan invoice">
      <bpmn:documentation>Setelah kontrol akses HTTP; lihat l3-kontrol-request. Kode membandingkan line PO dengan invoice. Bukan query three-way match GR terpisah pada saat match; PO RECEIVED sudah disyaratkan saat create.</bpmn:documentation>
      <bpmn:incoming>l3_ap_match_Flow_1</bpmn:incoming>
      <bpmn:outgoing>l3_ap_match_Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="l3_ap_match_valid" name="Hasil ExactMatch?" default="l3_ap_match_Flow_4" gatewayDirection="Diverging">
      <bpmn:incoming>l3_ap_match_Flow_2</bpmn:incoming>
      <bpmn:outgoing>l3_ap_match_Flow_4</bpmn:outgoing>
      <bpmn:outgoing>l3_ap_match_Flow_5</bpmn:outgoing>
      <bpmn:outgoing>l3_ap_match_Flow_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="l3_ap_match_positive" name="Set invoice POSTED">
      <bpmn:incoming>l3_ap_match_Flow_5</bpmn:incoming>
      <bpmn:outgoing>l3_ap_match_Flow_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="l3_ap_match_negative" name="Set invoice MATCH_EXCEPTION">
      <bpmn:incoming>l3_ap_match_Flow_6</bpmn:incoming>
      <bpmn:outgoing>l3_ap_match_Flow_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="l3_ap_match_effect1" name="Simpan mismatch_reason dan versi; audit PUR-INV-002; commit">
      <bpmn:incoming>l3_ap_match_Flow_7</bpmn:incoming>
      <bpmn:incoming>l3_ap_match_Flow_8</bpmn:incoming>
      <bpmn:outgoing>l3_ap_match_Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="l3_ap_match_done" name="Aksi selesai; hasil diterima">
      <bpmn:incoming>l3_ap_match_Flow_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="l3_ap_match_failed" name="Ditolak / gagal; tidak commit">
      <bpmn:incoming>l3_ap_match_Flow_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="l3_ap_match_Flow_0" sourceRef="l3_ap_match_start" targetRef="l3_ap_match_input"/>
    <bpmn:sequenceFlow id="l3_ap_match_Flow_1" sourceRef="l3_ap_match_input" targetRef="l3_ap_match_check"/>
    <bpmn:sequenceFlow id="l3_ap_match_Flow_2" sourceRef="l3_ap_match_check" targetRef="l3_ap_match_valid"/>
    <bpmn:sequenceFlow id="l3_ap_match_Flow_3" sourceRef="l3_ap_match_effect1" targetRef="l3_ap_match_done"/>
    <bpmn:sequenceFlow id="l3_ap_match_Flow_4" sourceRef="l3_ap_match_valid" targetRef="l3_ap_match_failed" name="Tidak"/>
    <bpmn:sequenceFlow id="l3_ap_match_Flow_5" sourceRef="l3_ap_match_valid" targetRef="l3_ap_match_positive" name="Cocok">
      <bpmn:conditionExpression language="text/plain" xsi:type="bpmn:tFormalExpression">Cocok</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="l3_ap_match_Flow_6" sourceRef="l3_ap_match_valid" targetRef="l3_ap_match_negative" name="Mismatch">
      <bpmn:conditionExpression language="text/plain" xsi:type="bpmn:tFormalExpression">Mismatch</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="l3_ap_match_Flow_7" sourceRef="l3_ap_match_positive" targetRef="l3_ap_match_effect1"/>
    <bpmn:sequenceFlow id="l3_ap_match_Flow_8" sourceRef="l3_ap_match_negative" targetRef="l3_ap_match_effect1"/>
  </bpmn:process>
  <bpmn:collaboration id="Collab_l3_ap_match">
    <bpmn:participant id="Pool_l3_ap_match" name="Simple ERP" processRef="Process_l3_ap_match"/>
  </bpmn:collaboration>
  <bpmndi:BPMNDiagram id="Diagram_l3_ap_match">
    <bpmndi:BPMNPlane id="Plane_l3_ap_match" bpmnElement="Collab_l3_ap_match">
      <bpmndi:BPMNShape id="Pool_l3_ap_match_di" bpmnElement="Pool_l3_ap_match" isHorizontal="true">
        <dc:Bounds x="20" y="100" width="2085" height="700"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_l3_ap_match_0_di" bpmnElement="Lane_l3_ap_match_0" isHorizontal="true">
        <dc:Bounds x="50" y="100.0" width="2055" height="350.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_l3_ap_match_1_di" bpmnElement="Lane_l3_ap_match_1" isHorizontal="true">
        <dc:Bounds x="50" y="450.0" width="2055" height="350.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="l3_ap_match_start_di" bpmnElement="l3_ap_match_start">
        <dc:Bounds x="200" y="171.0" width="38" height="38"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="145" y="214.0" width="148" height="45"/>
        </bpmndi:BPMNLabel>
