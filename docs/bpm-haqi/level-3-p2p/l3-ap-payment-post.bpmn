<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:tns="https://simple-erp.local/bpm-haqi/l3-ap-payment-post" id="Definitions_l3_ap_payment_post" targetNamespace="https://simple-erp.local/bpm-haqi/l3-ap-payment-post" exporter="Simple ERP source-backed documentation" exporterVersion="1">
  <bpmn:process id="Process_l3_ap_payment_post" name="Posting pembayaran supplier" isExecutable="false">
    <bpmn:documentation>Level 3; source snapshot 2026-10-21; descriptive as-is working tree, not deployed-runtime proof.
Created_by dibandingkan dengan actor, kecuali Super Admin aktif sebagai bypass.
backend/internal/finance/adapter/postgres/store.go :: PostSupplierPayment</bpmn:documentation>
    <bpmn:laneSet id="Lanes_l3_ap_payment_post">
      <bpmn:lane id="Lane_l3_ap_payment_post_0" name="Supervisor atau Super Admin">
        <bpmn:flowNodeRef>l3_ap_payment_post_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l3_ap_payment_post_input</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_l3_ap_payment_post_1" name="Sistem Simple ERP">
        <bpmn:flowNodeRef>l3_ap_payment_post_check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l3_ap_payment_post_valid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l3_ap_payment_post_effect0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l3_ap_payment_post_effect1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l3_ap_payment_post_effect2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l3_ap_payment_post_done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l3_ap_payment_post_failed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="l3_ap_payment_post_start" name="Kebutuhan aksi">
      <bpmn:outgoing>l3_ap_payment_post_Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="l3_ap_payment_post_input" name="Pilih Post Payment">
      <bpmn:documentation>Aktor alternatif pada lane, bukan dua persetujuan.</bpmn:documentation>
      <bpmn:incoming>l3_ap_payment_post_Flow_0</bpmn:incoming>
      <bpmn:outgoing>l3_ap_payment_post_Flow_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="l3_ap_payment_post_check" name="Lock payment/invoice; DRAFT dan versi cocok; party/currency/tanggal/outstanding valid; Supervisor bukan creator, Super Admin aktif boleh self-post">
      <bpmn:documentation>Setelah kontrol akses HTTP; lihat l3-kontrol-request. Created_by dibandingkan dengan actor, kecuali Super Admin aktif sebagai bypass.</bpmn:documentation>
      <bpmn:incoming>l3_ap_payment_post_Flow_1</bpmn:incoming>
      <bpmn:outgoing>l3_ap_payment_post_Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="l3_ap_payment_post_valid" name="Syarat terpenuhi?" default="l3_ap_payment_post_Flow_7" gatewayDirection="Diverging">
      <bpmn:incoming>l3_ap_payment_post_Flow_2</bpmn:incoming>
      <bpmn:outgoing>l3_ap_payment_post_Flow_3</bpmn:outgoing>
      <bpmn:outgoing>l3_ap_payment_post_Flow_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="l3_ap_payment_post_effect0" name="Kurangi outstanding; invoice PARTIALLY_PAID atau PAID">
      <bpmn:incoming>l3_ap_payment_post_Flow_3</bpmn:incoming>
      <bpmn:outgoing>l3_ap_payment_post_Flow_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="l3_ap_payment_post_effect1" name="Jika semua invoice non-VOID lunas: PO RECEIVED ke CLOSED; PR ke COMPLETED">
      <bpmn:incoming>l3_ap_payment_post_Flow_4</bpmn:incoming>
      <bpmn:outgoing>l3_ap_payment_post_Flow_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="l3_ap_payment_post_effect2" name="Payment POSTED; audit alokasi/penutupan; commit atomik">
      <bpmn:incoming>l3_ap_payment_post_Flow_5</bpmn:incoming>
      <bpmn:outgoing>l3_ap_payment_post_Flow_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="l3_ap_payment_post_done" name="Aksi selesai; hasil diterima">
      <bpmn:incoming>l3_ap_payment_post_Flow_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="l3_ap_payment_post_failed" name="Ditolak / gagal; tidak commit">
      <bpmn:incoming>l3_ap_payment_post_Flow_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="l3_ap_payment_post_Flow_0" sourceRef="l3_ap_payment_post_start" targetRef="l3_ap_payment_post_input"/>
    <bpmn:sequenceFlow id="l3_ap_payment_post_Flow_1" sourceRef="l3_ap_payment_post_input" targetRef="l3_ap_payment_post_check"/>
    <bpmn:sequenceFlow id="l3_ap_payment_post_Flow_2" sourceRef="l3_ap_payment_post_check" targetRef="l3_ap_payment_post_valid"/>
    <bpmn:sequenceFlow id="l3_ap_payment_post_Flow_3" sourceRef="l3_ap_payment_post_valid" targetRef="l3_ap_payment_post_effect0" name="Ya">
      <bpmn:conditionExpression language="text/plain" xsi:type="bpmn:tFormalExpression">Ya</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="l3_ap_payment_post_Flow_4" sourceRef="l3_ap_payment_post_effect0" targetRef="l3_ap_payment_post_effect1"/>
    <bpmn:sequenceFlow id="l3_ap_payment_post_Flow_5" sourceRef="l3_ap_payment_post_effect1" targetRef="l3_ap_payment_post_effect2"/>
    <bpmn:sequenceFlow id="l3_ap_payment_post_Flow_6" sourceRef="l3_ap_payment_post_effect2" targetRef="l3_ap_payment_post_done"/>
    <bpmn:sequenceFlow id="l3_ap_payment_post_Flow_7" sourceRef="l3_ap_payment_post_valid" targetRef="l3_ap_payment_post_failed" name="Tidak"/>
  </bpmn:process>
  <bpmn:collaboration id="Collab_l3_ap_payment_post">
    <bpmn:participant id="Pool_l3_ap_payment_post" name="Simple ERP" processRef="Process_l3_ap_payment_post"/>
  </bpmn:collaboration>
