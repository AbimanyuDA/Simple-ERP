        <bpmn:flowNodeRef>l2_purchase_correction_call4</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="l2_purchase_correction_start" name="Kebutuhan muncul">
      <bpmn:outgoing>l2_purchase_correction_Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="l2_purchase_correction_choose" name="Pilih kebutuhan">
      <bpmn:incoming>l2_purchase_correction_Flow_0</bpmn:incoming>
      <bpmn:outgoing>l2_purchase_correction_Flow_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="l2_purchase_correction_branch" name="Kebutuhan apa?" gatewayDirection="Diverging">
      <bpmn:incoming>l2_purchase_correction_Flow_1</bpmn:incoming>
      <bpmn:outgoing>l2_purchase_correction_Flow_2</bpmn:outgoing>
      <bpmn:outgoing>l2_purchase_correction_Flow_4</bpmn:outgoing>
      <bpmn:outgoing>l2_purchase_correction_Flow_6</bpmn:outgoing>
      <bpmn:outgoing>l2_purchase_correction_Flow_8</bpmn:outgoing>
      <bpmn:outgoing>l2_purchase_correction_Flow_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="l2_purchase_correction_merge" name="Gabung pilihan" gatewayDirection="Converging">
      <bpmn:incoming>l2_purchase_correction_Flow_3</bpmn:incoming>
      <bpmn:incoming>l2_purchase_correction_Flow_5</bpmn:incoming>
      <bpmn:incoming>l2_purchase_correction_Flow_7</bpmn:incoming>
      <bpmn:incoming>l2_purchase_correction_Flow_9</bpmn:incoming>
      <bpmn:incoming>l2_purchase_correction_Flow_11</bpmn:incoming>
      <bpmn:outgoing>l2_purchase_correction_Flow_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="l2_purchase_correction_end" name="Satu koreksi diproses">
      <bpmn:incoming>l2_purchase_correction_Flow_12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:callActivity id="l2_purchase_correction_call0" name="Batalkan PR" calledElement="c0:Process_l3_pr_cancel">
      <bpmn:incoming>l2_purchase_correction_Flow_2</bpmn:incoming>
      <bpmn:outgoing>l2_purchase_correction_Flow_3</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:callActivity id="l2_purchase_correction_call1" name="Copy PR ditolak" calledElement="c1:Process_l3_pr_copy">
      <bpmn:incoming>l2_purchase_correction_Flow_4</bpmn:incoming>
      <bpmn:outgoing>l2_purchase_correction_Flow_5</bpmn:outgoing>
