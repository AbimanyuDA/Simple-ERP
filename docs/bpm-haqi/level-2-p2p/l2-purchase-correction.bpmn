    <bpmn:callActivity id="l2_purchase_correction_call4" name="Reverse GR" calledElement="c4:Process_l3_gr_reverse">
      <bpmn:incoming>l2_purchase_correction_Flow_10</bpmn:incoming>
      <bpmn:outgoing>l2_purchase_correction_Flow_11</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:sequenceFlow id="l2_purchase_correction_Flow_0" sourceRef="l2_purchase_correction_start" targetRef="l2_purchase_correction_choose"/>
    <bpmn:sequenceFlow id="l2_purchase_correction_Flow_1" sourceRef="l2_purchase_correction_choose" targetRef="l2_purchase_correction_branch"/>
