  <bpmn:process id="Process_l2_purchase_correction" name="Pembatalan dan koreksi Purchasing" isExecutable="false">
    <bpmn:documentation>Level 2; source snapshot 2026-10-21; descriptive as-is working tree, not deployed-runtime proof.</bpmn:documentation>
    <bpmn:laneSet id="Lanes_l2_purchase_correction">
      <bpmn:lane id="Lane_l2_purchase_correction_0" name="Pemilik kebutuhan (role pada detail)">
        <bpmn:flowNodeRef>l2_purchase_correction_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l2_purchase_correction_choose</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l2_purchase_correction_branch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l2_purchase_correction_merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l2_purchase_correction_end</bpmn:flowNodeRef>
