      <bpmn:conditionExpression language="text/plain" xsi:type="bpmn:tFormalExpression">Batalkan GR draft</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="l2_purchase_correction_Flow_9" sourceRef="l2_purchase_correction_call3" targetRef="l2_purchase_correction_merge"/>
    <bpmn:sequenceFlow id="l2_purchase_correction_Flow_10" sourceRef="l2_purchase_correction_branch" targetRef="l2_purchase_correction_call4" name="Reverse GR">
      <bpmn:conditionExpression language="text/plain" xsi:type="bpmn:tFormalExpression">Reverse GR</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="l2_purchase_correction_Flow_11" sourceRef="l2_purchase_correction_call4" targetRef="l2_purchase_correction_merge"/>
