      <bpmn:conditionExpression language="text/plain" xsi:type="bpmn:tFormalExpression">Batalkan PR</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="l2_purchase_correction_Flow_3" sourceRef="l2_purchase_correction_call0" targetRef="l2_purchase_correction_merge"/>
    <bpmn:sequenceFlow id="l2_purchase_correction_Flow_4" sourceRef="l2_purchase_correction_branch" targetRef="l2_purchase_correction_call1" name="Copy PR ditolak">
