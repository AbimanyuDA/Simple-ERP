<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:tns="https://simple-erp.local/bpm-haqi/l2-pr" xmlns:c0="https://simple-erp.local/bpm-haqi/l3-pr-create" xmlns:c1="https://simple-erp.local/bpm-haqi/l3-pr-submit" xmlns:c2="https://simple-erp.local/bpm-haqi/l3-pr-review" id="Definitions_l2_pr" targetNamespace="https://simple-erp.local/bpm-haqi/l2-pr" exporter="Simple ERP source-backed documentation" exporterVersion="1">
  <bpmn:import namespace="https://simple-erp.local/bpm-haqi/l3-pr-create" location="../level-3-p2p/l3-pr-create.bpmn" importType="http://www.omg.org/spec/BPMN/20100524/MODEL"/>
  <bpmn:import namespace="https://simple-erp.local/bpm-haqi/l3-pr-submit" location="../level-3-p2p/l3-pr-submit.bpmn" importType="http://www.omg.org/spec/BPMN/20100524/MODEL"/>
  <bpmn:import namespace="https://simple-erp.local/bpm-haqi/l3-pr-review" location="../level-3-p2p/l3-pr-review.bpmn" importType="http://www.omg.org/spec/BPMN/20100524/MODEL"/>
  <bpmn:process id="Process_l2_pr" name="Purchase Request dari draft sampai review" isExecutable="false">
    <bpmn:documentation>Level 2; source snapshot 2026-10-21; descriptive as-is working tree, not deployed-runtime proof.
REJECTED dapat disalin lewat l2-purchase-correction; bukan edit atau resubmit PR lama.
backend/internal/purchasing/adapter/postgres/store.go :: CreateRequest / TransitionRequest</bpmn:documentation>
    <bpmn:laneSet id="Lanes_l2_pr">
      <bpmn:lane id="Lane_l2_pr_0" name="Staff atau Super Admin">
        <bpmn:flowNodeRef>l2_pr_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l2_pr_stage0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l2_pr_stage1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_l2_pr_1" name="Sistem Simple ERP">
        <bpmn:flowNodeRef>l2_pr_gate0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l2_pr_exit0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l2_pr_gate1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l2_pr_exit1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l2_pr_gate2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l2_pr_exit2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l2_pr_end</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l2_pr_rejected</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_l2_pr_2" name="Supervisor atau Super Admin">
        <bpmn:flowNodeRef>l2_pr_stage2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="l2_pr_start" name="Kebutuhan dokumen">
      <bpmn:outgoing>l2_pr_Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:callActivity id="l2_pr_stage0" name="Buat PR" calledElement="c0:Process_l3_pr_create">
      <bpmn:incoming>l2_pr_Flow_0</bpmn:incoming>
      <bpmn:outgoing>l2_pr_Flow_1</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="l2_pr_gate0" name="PR DRAFT berhasil?" default="l2_pr_Flow_2" gatewayDirection="Diverging">
      <bpmn:incoming>l2_pr_Flow_1</bpmn:incoming>
      <bpmn:outgoing>l2_pr_Flow_2</bpmn:outgoing>
      <bpmn:outgoing>l2_pr_Flow_3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="l2_pr_exit0" name="PR belum dibuat">
      <bpmn:incoming>l2_pr_Flow_2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:callActivity id="l2_pr_stage1" name="Submit PR" calledElement="c1:Process_l3_pr_submit">
      <bpmn:incoming>l2_pr_Flow_3</bpmn:incoming>
      <bpmn:outgoing>l2_pr_Flow_4</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="l2_pr_gate1" name="PR SUBMITTED?" default="l2_pr_Flow_5" gatewayDirection="Diverging">
      <bpmn:incoming>l2_pr_Flow_4</bpmn:incoming>
      <bpmn:outgoing>l2_pr_Flow_5</bpmn:outgoing>
      <bpmn:outgoing>l2_pr_Flow_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="l2_pr_exit1" name="PR belum submitted">
      <bpmn:incoming>l2_pr_Flow_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:callActivity id="l2_pr_stage2" name="Review PR" calledElement="c2:Process_l3_pr_review">
      <bpmn:incoming>l2_pr_Flow_6</bpmn:incoming>
      <bpmn:outgoing>l2_pr_Flow_7</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="l2_pr_gate2" name="Hasil review?" default="l2_pr_Flow_10" gatewayDirection="Diverging">
      <bpmn:incoming>l2_pr_Flow_7</bpmn:incoming>
      <bpmn:outgoing>l2_pr_Flow_8</bpmn:outgoing>
      <bpmn:outgoing>l2_pr_Flow_9</bpmn:outgoing>
      <bpmn:outgoing>l2_pr_Flow_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="l2_pr_exit2" name="PR belum approved">
      <bpmn:incoming>l2_pr_Flow_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="l2_pr_end" name="Tahap selesai">
      <bpmn:incoming>l2_pr_Flow_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="l2_pr_rejected" name="PR REJECTED">
      <bpmn:incoming>l2_pr_Flow_8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="l2_pr_Flow_0" sourceRef="l2_pr_start" targetRef="l2_pr_stage0"/>
    <bpmn:sequenceFlow id="l2_pr_Flow_1" sourceRef="l2_pr_stage0" targetRef="l2_pr_gate0"/>
    <bpmn:sequenceFlow id="l2_pr_Flow_2" sourceRef="l2_pr_gate0" targetRef="l2_pr_exit0" name="Tidak"/>
    <bpmn:sequenceFlow id="l2_pr_Flow_3" sourceRef="l2_pr_gate0" targetRef="l2_pr_stage1" name="Ya">
      <bpmn:conditionExpression language="text/plain" xsi:type="bpmn:tFormalExpression">Ya</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="l2_pr_Flow_4" sourceRef="l2_pr_stage1" targetRef="l2_pr_gate1"/>
    <bpmn:sequenceFlow id="l2_pr_Flow_5" sourceRef="l2_pr_gate1" targetRef="l2_pr_exit1" name="Tidak"/>
    <bpmn:sequenceFlow id="l2_pr_Flow_6" sourceRef="l2_pr_gate1" targetRef="l2_pr_stage2" name="Ya">
      <bpmn:conditionExpression language="text/plain" xsi:type="bpmn:tFormalExpression">Ya</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="l2_pr_Flow_7" sourceRef="l2_pr_stage2" targetRef="l2_pr_gate2"/>
    <bpmn:sequenceFlow id="l2_pr_Flow_8" sourceRef="l2_pr_gate2" targetRef="l2_pr_rejected" name="PR REJECTED">
      <bpmn:conditionExpression language="text/plain" xsi:type="bpmn:tFormalExpression">PR REJECTED</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="l2_pr_Flow_9" sourceRef="l2_pr_gate2" targetRef="l2_pr_end" name="APPROVED">
      <bpmn:conditionExpression language="text/plain" xsi:type="bpmn:tFormalExpression">APPROVED</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="l2_pr_Flow_10" sourceRef="l2_pr_gate2" targetRef="l2_pr_exit2" name="Review gagal"/>
  </bpmn:process>
  <bpmn:collaboration id="Collab_l2_pr">
    <bpmn:participant id="Pool_l2_pr" name="Simple ERP" processRef="Process_l2_pr"/>
  </bpmn:collaboration>
