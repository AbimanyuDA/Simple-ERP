<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:tns="https://simple-erp.local/bpm-haqi/l2-ap" xmlns:c0="https://simple-erp.local/bpm-haqi/l3-ap-invoice" xmlns:c1="https://simple-erp.local/bpm-haqi/l3-ap-match" xmlns:c2="https://simple-erp.local/bpm-haqi/l3-ap-payment" xmlns:c3="https://simple-erp.local/bpm-haqi/l3-ap-payment-post" xmlns:c4="https://simple-erp.local/bpm-haqi/l3-ap-resolve" id="Definitions_l2_ap" targetNamespace="https://simple-erp.local/bpm-haqi/l2-ap" exporter="Simple ERP source-backed documentation" exporterVersion="1">
  <bpmn:import namespace="https://simple-erp.local/bpm-haqi/l3-ap-invoice" location="../level-3-p2p/l3-ap-invoice.bpmn" importType="http://www.omg.org/spec/BPMN/20100524/MODEL"/>
  <bpmn:import namespace="https://simple-erp.local/bpm-haqi/l3-ap-match" location="../level-3-p2p/l3-ap-match.bpmn" importType="http://www.omg.org/spec/BPMN/20100524/MODEL"/>
  <bpmn:import namespace="https://simple-erp.local/bpm-haqi/l3-ap-payment" location="../level-3-p2p/l3-ap-payment.bpmn" importType="http://www.omg.org/spec/BPMN/20100524/MODEL"/>
  <bpmn:import namespace="https://simple-erp.local/bpm-haqi/l3-ap-payment-post" location="../level-3-p2p/l3-ap-payment-post.bpmn" importType="http://www.omg.org/spec/BPMN/20100524/MODEL"/>
  <bpmn:import namespace="https://simple-erp.local/bpm-haqi/l3-ap-resolve" location="../level-3-p2p/l3-ap-resolve.bpmn" importType="http://www.omg.org/spec/BPMN/20100524/MODEL"/>
  <bpmn:process id="Process_l2_ap" name="Invoice supplier sampai pelunasan" isExecutable="false">
    <bpmn:documentation>Level 2; source snapshot 2026-10-21; descriptive as-is working tree, not deployed-runtime proof.
MATCH_EXCEPTION: Staff resolve lalu Supervisor match ulang. Pembayaran parsial diulang; PO/PR ditutup hanya jika semua invoice non-VOID PAID. Supervisor tidak boleh match/post dokumen sendiri; Super Admin boleh bypass.
backend/internal/finance/adapter/postgres/store.go :: CreateSupplierInvoice / MatchSupplierInvoice / PostSupplierPayment</bpmn:documentation>
    <bpmn:laneSet id="Lanes_l2_ap">
      <bpmn:lane id="Lane_l2_ap_0" name="Staff atau Super Admin">
        <bpmn:flowNodeRef>l2_ap_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l2_ap_stage0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l2_ap_stage2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l2_ap_resolve</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_l2_ap_1" name="Sistem Simple ERP">
        <bpmn:flowNodeRef>l2_ap_gate0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l2_ap_exit0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l2_ap_gate1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l2_ap_exit1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l2_ap_gate2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l2_ap_exit2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l2_ap_gate3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l2_ap_exit3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l2_ap_end</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l2_ap_resolved</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_l2_ap_2" name="Supervisor atau Super Admin">
        <bpmn:flowNodeRef>l2_ap_stage1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l2_ap_stage3</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="l2_ap_start" name="Kebutuhan dokumen">
      <bpmn:outgoing>l2_ap_Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:callActivity id="l2_ap_stage0" name="Staff catat invoice setelah PO RECEIVED" calledElement="c0:Process_l3_ap_invoice">
      <bpmn:incoming>l2_ap_Flow_0</bpmn:incoming>
      <bpmn:outgoing>l2_ap_Flow_1</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="l2_ap_gate0" name="Invoice MATCH_PENDING?" default="l2_ap_Flow_2" gatewayDirection="Diverging">
      <bpmn:incoming>l2_ap_Flow_1</bpmn:incoming>
      <bpmn:outgoing>l2_ap_Flow_2</bpmn:outgoing>
      <bpmn:outgoing>l2_ap_Flow_3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="l2_ap_exit0" name="Invoice belum dicatat">
      <bpmn:incoming>l2_ap_Flow_2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:callActivity id="l2_ap_stage1" name="Match invoice" calledElement="c1:Process_l3_ap_match">
      <bpmn:incoming>l2_ap_Flow_3</bpmn:incoming>
      <bpmn:incoming>l2_ap_Flow_16</bpmn:incoming>
      <bpmn:outgoing>l2_ap_Flow_4</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="l2_ap_gate1" name="Hasil match invoice?" default="l2_ap_Flow_14" gatewayDirection="Diverging">
      <bpmn:incoming>l2_ap_Flow_4</bpmn:incoming>
      <bpmn:outgoing>l2_ap_Flow_12</bpmn:outgoing>
      <bpmn:outgoing>l2_ap_Flow_13</bpmn:outgoing>
      <bpmn:outgoing>l2_ap_Flow_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="l2_ap_exit1" name="Match belum selesai">
      <bpmn:incoming>l2_ap_Flow_14</bpmn:incoming>
      <bpmn:incoming>l2_ap_Flow_17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:callActivity id="l2_ap_stage2" name="Staff catat pembayaran supplier" calledElement="c2:Process_l3_ap_payment">
      <bpmn:incoming>l2_ap_Flow_10</bpmn:incoming>
      <bpmn:incoming>l2_ap_Flow_12</bpmn:incoming>
      <bpmn:outgoing>l2_ap_Flow_5</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="l2_ap_gate2" name="Payment DRAFT?" default="l2_ap_Flow_6" gatewayDirection="Diverging">
      <bpmn:incoming>l2_ap_Flow_5</bpmn:incoming>
      <bpmn:outgoing>l2_ap_Flow_6</bpmn:outgoing>
      <bpmn:outgoing>l2_ap_Flow_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="l2_ap_exit2" name="Payment belum dicatat">
      <bpmn:incoming>l2_ap_Flow_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:callActivity id="l2_ap_stage3" name="Post pembayaran" calledElement="c3:Process_l3_ap_payment_post">
      <bpmn:incoming>l2_ap_Flow_7</bpmn:incoming>
      <bpmn:outgoing>l2_ap_Flow_8</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="l2_ap_gate3" name="Hasil posting payment supplier?" default="l2_ap_Flow_11" gatewayDirection="Diverging">
      <bpmn:incoming>l2_ap_Flow_8</bpmn:incoming>
      <bpmn:outgoing>l2_ap_Flow_9</bpmn:outgoing>
      <bpmn:outgoing>l2_ap_Flow_10</bpmn:outgoing>
      <bpmn:outgoing>l2_ap_Flow_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="l2_ap_exit3" name="Payment belum posted">
      <bpmn:incoming>l2_ap_Flow_11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="l2_ap_end" name="Tahap selesai">
      <bpmn:incoming>l2_ap_Flow_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:callActivity id="l2_ap_resolve" name="Staff perbaiki MATCH_EXCEPTION" calledElement="c4:Process_l3_ap_resolve">
      <bpmn:incoming>l2_ap_Flow_13</bpmn:incoming>
      <bpmn:outgoing>l2_ap_Flow_15</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="l2_ap_resolved" name="Hasil perbaikan invoice?" default="l2_ap_Flow_17" gatewayDirection="Diverging">
      <bpmn:incoming>l2_ap_Flow_15</bpmn:incoming>
      <bpmn:outgoing>l2_ap_Flow_16</bpmn:outgoing>
      <bpmn:outgoing>l2_ap_Flow_17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="l2_ap_Flow_0" sourceRef="l2_ap_start" targetRef="l2_ap_stage0"/>
    <bpmn:sequenceFlow id="l2_ap_Flow_1" sourceRef="l2_ap_stage0" targetRef="l2_ap_gate0"/>
    <bpmn:sequenceFlow id="l2_ap_Flow_2" sourceRef="l2_ap_gate0" targetRef="l2_ap_exit0" name="Tidak"/>
    <bpmn:sequenceFlow id="l2_ap_Flow_3" sourceRef="l2_ap_gate0" targetRef="l2_ap_stage1" name="Ya">
      <bpmn:conditionExpression language="text/plain" xsi:type="bpmn:tFormalExpression">Ya</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="l2_ap_Flow_4" sourceRef="l2_ap_stage1" targetRef="l2_ap_gate1"/>
    <bpmn:sequenceFlow id="l2_ap_Flow_5" sourceRef="l2_ap_stage2" targetRef="l2_ap_gate2"/>
    <bpmn:sequenceFlow id="l2_ap_Flow_6" sourceRef="l2_ap_gate2" targetRef="l2_ap_exit2" name="Tidak"/>
    <bpmn:sequenceFlow id="l2_ap_Flow_7" sourceRef="l2_ap_gate2" targetRef="l2_ap_stage3" name="Ya">
      <bpmn:conditionExpression language="text/plain" xsi:type="bpmn:tFormalExpression">Ya</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="l2_ap_Flow_8" sourceRef="l2_ap_stage3" targetRef="l2_ap_gate3"/>
    <bpmn:sequenceFlow id="l2_ap_Flow_9" sourceRef="l2_ap_gate3" targetRef="l2_ap_end" name="PO CLOSED">
      <bpmn:conditionExpression language="text/plain" xsi:type="bpmn:tFormalExpression">PO CLOSED</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="l2_ap_Flow_10" sourceRef="l2_ap_gate3" targetRef="l2_ap_stage2" name="PO RECEIVED">
      <bpmn:conditionExpression language="text/plain" xsi:type="bpmn:tFormalExpression">PO RECEIVED</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="l2_ap_Flow_11" sourceRef="l2_ap_gate3" targetRef="l2_ap_exit3" name="Payment gagal"/>
    <bpmn:sequenceFlow id="l2_ap_Flow_12" sourceRef="l2_ap_gate1" targetRef="l2_ap_stage2" name="POSTED">
      <bpmn:conditionExpression language="text/plain" xsi:type="bpmn:tFormalExpression">POSTED</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="l2_ap_Flow_13" sourceRef="l2_ap_gate1" targetRef="l2_ap_resolve" name="Mismatch">
      <bpmn:conditionExpression language="text/plain" xsi:type="bpmn:tFormalExpression">Mismatch</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="l2_ap_Flow_14" sourceRef="l2_ap_gate1" targetRef="l2_ap_exit1" name="Request match gagal"/>
    <bpmn:sequenceFlow id="l2_ap_Flow_15" sourceRef="l2_ap_resolve" targetRef="l2_ap_resolved"/>
    <bpmn:sequenceFlow id="l2_ap_Flow_16" sourceRef="l2_ap_resolved" targetRef="l2_ap_stage1" name="MATCH_PENDING">
      <bpmn:conditionExpression language="text/plain" xsi:type="bpmn:tFormalExpression">MATCH_PENDING</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="l2_ap_Flow_17" sourceRef="l2_ap_resolved" targetRef="l2_ap_exit1" name="Perbaikan gagal"/>
  </bpmn:process>
  <bpmn:collaboration id="Collab_l2_ap">
    <bpmn:participant id="Pool_l2_ap" name="Simple ERP" processRef="Process_l2_ap"/>
  </bpmn:collaboration>
