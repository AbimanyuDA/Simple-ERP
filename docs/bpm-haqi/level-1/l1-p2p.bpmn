<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:tns="https://simple-erp.local/bpm-haqi/l1-p2p" xmlns:c0="https://simple-erp.local/bpm-haqi/l2-pr" xmlns:c1="https://simple-erp.local/bpm-haqi/l2-po-gr" xmlns:c2="https://simple-erp.local/bpm-haqi/l2-ap" xmlns:c3="https://simple-erp.local/bpm-haqi/l2-p2p-correction" id="Definitions_l1_p2p" targetNamespace="https://simple-erp.local/bpm-haqi/l1-p2p" exporter="Simple ERP source-backed documentation" exporterVersion="1">
  <bpmn:import namespace="https://simple-erp.local/bpm-haqi/l2-pr" location="../level-2-p2p/l2-pr.bpmn" importType="http://www.omg.org/spec/BPMN/20100524/MODEL"/>
  <bpmn:import namespace="https://simple-erp.local/bpm-haqi/l2-po-gr" location="../level-2-p2p/l2-po-gr.bpmn" importType="http://www.omg.org/spec/BPMN/20100524/MODEL"/>
  <bpmn:import namespace="https://simple-erp.local/bpm-haqi/l2-ap" location="../level-2-p2p/l2-ap.bpmn" importType="http://www.omg.org/spec/BPMN/20100524/MODEL"/>
  <bpmn:import namespace="https://simple-erp.local/bpm-haqi/l2-p2p-correction" location="../level-2-p2p/l2-p2p-correction.bpmn" importType="http://www.omg.org/spec/BPMN/20100524/MODEL"/>
  <bpmn:process id="Process_l1_p2p" name="Procure to Pay - permintaan sampai pelunasan" isExecutable="false">
    <bpmn:documentation>Level 1; source snapshot 2026-10-21; descriptive as-is working tree, not deployed-runtime proof.
Perspektif bisnis Staff dan Supervisor. Staff menyiapkan PR, PO, GR, invoice dan payment supplier; Supervisor mereview/menerbitkan/mem-post/match. Super Admin tidak ditampilkan sebagai pelaku proses, tetapi kode saat ini masih mengizinkan akses operasionalnya. Supervisor tidak boleh mengesahkan dokumennya sendiri; Super Admin boleh bypass self-approval. Koreksi PR/PO/GR/invoice/payment tersedia melalui l2-p2p-correction.
backend/internal/purchasing/adapter/postgres/store.go :: CreateRequest / ConvertToOrder / PostReceipt
backend/internal/finance/adapter/postgres/store.go :: PostSupplierPayment</bpmn:documentation>
    <bpmn:laneSet id="Lanes_l1_p2p">
      <bpmn:lane id="Lane_l1_p2p_0" name="Staff">
        <bpmn:flowNodeRef>l1_p2p_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l1_p2p_mode</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_l1_p2p_1" name="Staff dan Supervisor">
        <bpmn:flowNodeRef>l1_p2p_stage0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l1_p2p_stage1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l1_p2p_stage2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_l1_p2p_2" name="Sistem Simple ERP">
        <bpmn:flowNodeRef>l1_p2p_gate0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l1_p2p_exit0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l1_p2p_gate1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l1_p2p_exit1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l1_p2p_gate2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l1_p2p_exit2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l1_p2p_end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_l1_p2p_3" name="Staff atau Supervisor sesuai aksi">
        <bpmn:flowNodeRef>l1_p2p_correction</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l1_p2p_corrected</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="l1_p2p_start" name="Kebutuhan dokumen">
      <bpmn:outgoing>l1_p2p_Flow_9</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="l1_p2p_mode" name="Proses baru atau koreksi?" gatewayDirection="Diverging">
      <bpmn:incoming>l1_p2p_Flow_9</bpmn:incoming>
      <bpmn:outgoing>l1_p2p_Flow_10</bpmn:outgoing>
      <bpmn:outgoing>l1_p2p_Flow_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="l1_p2p_stage0" name="Permintaan dan review PR" calledElement="c0:Process_l2_pr">
      <bpmn:incoming>l1_p2p_Flow_10</bpmn:incoming>
      <bpmn:outgoing>l1_p2p_Flow_0</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="l1_p2p_gate0" name="PR APPROVED?" default="l1_p2p_Flow_1" gatewayDirection="Diverging">
      <bpmn:incoming>l1_p2p_Flow_0</bpmn:incoming>
      <bpmn:outgoing>l1_p2p_Flow_1</bpmn:outgoing>
      <bpmn:outgoing>l1_p2p_Flow_2</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="l1_p2p_exit0" name="PR belum approved">
      <bpmn:incoming>l1_p2p_Flow_1</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:callActivity id="l1_p2p_stage1" name="PO dan penerimaan penuh" calledElement="c1:Process_l2_po_gr">
      <bpmn:incoming>l1_p2p_Flow_2</bpmn:incoming>
      <bpmn:outgoing>l1_p2p_Flow_3</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="l1_p2p_gate1" name="PO RECEIVED?" default="l1_p2p_Flow_4" gatewayDirection="Diverging">
      <bpmn:incoming>l1_p2p_Flow_3</bpmn:incoming>
      <bpmn:outgoing>l1_p2p_Flow_4</bpmn:outgoing>
      <bpmn:outgoing>l1_p2p_Flow_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="l1_p2p_exit1" name="PO belum diterima penuh">
      <bpmn:incoming>l1_p2p_Flow_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:callActivity id="l1_p2p_stage2" name="Invoice dan pembayaran supplier" calledElement="c2:Process_l2_ap">
      <bpmn:incoming>l1_p2p_Flow_5</bpmn:incoming>
      <bpmn:outgoing>l1_p2p_Flow_6</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="l1_p2p_gate2" name="PO CLOSED dan PR COMPLETED?" default="l1_p2p_Flow_7" gatewayDirection="Diverging">
      <bpmn:incoming>l1_p2p_Flow_6</bpmn:incoming>
      <bpmn:outgoing>l1_p2p_Flow_7</bpmn:outgoing>
      <bpmn:outgoing>l1_p2p_Flow_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="l1_p2p_exit2" name="Pelunasan belum selesai">
      <bpmn:incoming>l1_p2p_Flow_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="l1_p2p_end" name="Tahap selesai">
      <bpmn:incoming>l1_p2p_Flow_8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:callActivity id="l1_p2p_correction" name="Koreksi dokumen yang ada" calledElement="c3:Process_l2_p2p_correction">
      <bpmn:incoming>l1_p2p_Flow_11</bpmn:incoming>
      <bpmn:outgoing>l1_p2p_Flow_12</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:endEvent id="l1_p2p_corrected" name="Upaya koreksi selesai; cek hasil">
      <bpmn:incoming>l1_p2p_Flow_12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="l1_p2p_Flow_0" sourceRef="l1_p2p_stage0" targetRef="l1_p2p_gate0"/>
    <bpmn:sequenceFlow id="l1_p2p_Flow_1" sourceRef="l1_p2p_gate0" targetRef="l1_p2p_exit0" name="Tidak"/>
    <bpmn:sequenceFlow id="l1_p2p_Flow_2" sourceRef="l1_p2p_gate0" targetRef="l1_p2p_stage1" name="Ya">
      <bpmn:conditionExpression language="text/plain" xsi:type="bpmn:tFormalExpression">Ya</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="l1_p2p_Flow_3" sourceRef="l1_p2p_stage1" targetRef="l1_p2p_gate1"/>
    <bpmn:sequenceFlow id="l1_p2p_Flow_4" sourceRef="l1_p2p_gate1" targetRef="l1_p2p_exit1" name="Tidak"/>
    <bpmn:sequenceFlow id="l1_p2p_Flow_5" sourceRef="l1_p2p_gate1" targetRef="l1_p2p_stage2" name="Ya">
      <bpmn:conditionExpression language="text/plain" xsi:type="bpmn:tFormalExpression">Ya</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="l1_p2p_Flow_6" sourceRef="l1_p2p_stage2" targetRef="l1_p2p_gate2"/>
    <bpmn:sequenceFlow id="l1_p2p_Flow_7" sourceRef="l1_p2p_gate2" targetRef="l1_p2p_exit2" name="Tidak"/>
    <bpmn:sequenceFlow id="l1_p2p_Flow_8" sourceRef="l1_p2p_gate2" targetRef="l1_p2p_end" name="Ya">
      <bpmn:conditionExpression language="text/plain" xsi:type="bpmn:tFormalExpression">Ya</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="l1_p2p_Flow_9" sourceRef="l1_p2p_start" targetRef="l1_p2p_mode"/>
    <bpmn:sequenceFlow id="l1_p2p_Flow_10" sourceRef="l1_p2p_mode" targetRef="l1_p2p_stage0" name="Proses baru">
      <bpmn:conditionExpression language="text/plain" xsi:type="bpmn:tFormalExpression">Proses baru</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="l1_p2p_Flow_11" sourceRef="l1_p2p_mode" targetRef="l1_p2p_correction" name="Koreksi">
      <bpmn:conditionExpression language="text/plain" xsi:type="bpmn:tFormalExpression">Koreksi</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="l1_p2p_Flow_12" sourceRef="l1_p2p_correction" targetRef="l1_p2p_corrected"/>
  </bpmn:process>
  <bpmn:collaboration id="Collab_l1_p2p">
    <bpmn:participant id="Pool_l1_p2p" name="Simple ERP" processRef="Process_l1_p2p"/>
  </bpmn:collaboration>
