<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:tns="https://simple-erp.local/bpm-haqi/l1-o2c" xmlns:c0="https://simple-erp.local/bpm-haqi/l2-so" xmlns:c1="https://simple-erp.local/bpm-haqi/l2-delivery" xmlns:c2="https://simple-erp.local/bpm-haqi/l2-ar" xmlns:c3="https://simple-erp.local/bpm-haqi/l2-sales-correction" id="Definitions_l1_o2c" targetNamespace="https://simple-erp.local/bpm-haqi/l1-o2c" exporter="Simple ERP source-backed documentation" exporterVersion="1">
  <bpmn:import namespace="https://simple-erp.local/bpm-haqi/l2-so" location="../level-2/l2-so.bpmn" importType="http://www.omg.org/spec/BPMN/20100524/MODEL"/>
  <bpmn:import namespace="https://simple-erp.local/bpm-haqi/l2-delivery" location="../level-2/l2-delivery.bpmn" importType="http://www.omg.org/spec/BPMN/20100524/MODEL"/>
  <bpmn:import namespace="https://simple-erp.local/bpm-haqi/l2-ar" location="../level-2/l2-ar.bpmn" importType="http://www.omg.org/spec/BPMN/20100524/MODEL"/>
  <bpmn:import namespace="https://simple-erp.local/bpm-haqi/l2-sales-correction" location="../level-2/l2-sales-correction.bpmn" importType="http://www.omg.org/spec/BPMN/20100524/MODEL"/>
  <bpmn:process id="Process_l1_o2c" name="Order to Cash - pesanan sampai pelunasan" isExecutable="false">
    <bpmn:documentation>Level 1; source snapshot 2026-10-21; descriptive as-is working tree, not deployed-runtime proof.
Alur bisnis lintas request dan role; bukan satu transaksi DB. Koreksi dokumen yang sudah ada adalah jalur alternatif. Detail role berada pada child L2/L3; koreksi Finance melalui l2-finance-correction.
backend/internal/sales/adapter/postgres/store.go :: CreateOrder / TransitionOrder / PostDelivery
backend/internal/finance/adapter/postgres/store.go :: PostCustomerPayment</bpmn:documentation>
    <bpmn:laneSet id="Lanes_l1_o2c">
      <bpmn:lane id="Lane_l1_o2c_0" name="Staff atau Super Admin">
        <bpmn:flowNodeRef>l1_o2c_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l1_o2c_mode</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l1_o2c_stage0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l1_o2c_stage1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_l1_o2c_1" name="Sistem Simple ERP">
        <bpmn:flowNodeRef>l1_o2c_gate0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l1_o2c_exit0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l1_o2c_gate1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l1_o2c_exit1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l1_o2c_gate2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l1_o2c_exit2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l1_o2c_end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_l1_o2c_2" name="Staff dan Supervisor">
        <bpmn:flowNodeRef>l1_o2c_stage2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_l1_o2c_3" name="Pengguna (semua role)">
        <bpmn:flowNodeRef>l1_o2c_correction</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l1_o2c_corrected</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="l1_o2c_start" name="Kebutuhan dokumen">
      <bpmn:outgoing>l1_o2c_Flow_9</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="l1_o2c_mode" name="Proses baru atau koreksi?" default="l1_o2c_Flow_11" gatewayDirection="Diverging">
      <bpmn:incoming>l1_o2c_Flow_9</bpmn:incoming>
      <bpmn:outgoing>l1_o2c_Flow_10</bpmn:outgoing>
      <bpmn:outgoing>l1_o2c_Flow_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="l1_o2c_stage0" name="Order, review dan konfirmasi" calledElement="c0:Process_l2_so">
      <bpmn:incoming>l1_o2c_Flow_10</bpmn:incoming>
      <bpmn:outgoing>l1_o2c_Flow_0</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="l1_o2c_gate0" name="SO APPROVED dan confirmed?" default="l1_o2c_Flow_1" gatewayDirection="Diverging">
      <bpmn:incoming>l1_o2c_Flow_0</bpmn:incoming>
      <bpmn:outgoing>l1_o2c_Flow_1</bpmn:outgoing>
      <bpmn:outgoing>l1_o2c_Flow_2</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="l1_o2c_exit0" name="Belum lanjut; periksa hasil aksi">
      <bpmn:incoming>l1_o2c_Flow_1</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:callActivity id="l1_o2c_stage1" name="Delivery penuh" calledElement="c1:Process_l2_delivery">
      <bpmn:incoming>l1_o2c_Flow_2</bpmn:incoming>
      <bpmn:outgoing>l1_o2c_Flow_3</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="l1_o2c_gate1" name="SO DELIVERED?" default="l1_o2c_Flow_4" gatewayDirection="Diverging">
      <bpmn:incoming>l1_o2c_Flow_3</bpmn:incoming>
      <bpmn:outgoing>l1_o2c_Flow_4</bpmn:outgoing>
      <bpmn:outgoing>l1_o2c_Flow_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="l1_o2c_exit1" name="Belum lanjut; periksa hasil aksi">
      <bpmn:incoming>l1_o2c_Flow_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:callActivity id="l1_o2c_stage2" name="Invoice dan pembayaran customer" calledElement="c2:Process_l2_ar">
      <bpmn:incoming>l1_o2c_Flow_5</bpmn:incoming>
      <bpmn:outgoing>l1_o2c_Flow_6</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="l1_o2c_gate2" name="SO COMPLETED?" default="l1_o2c_Flow_7" gatewayDirection="Diverging">
      <bpmn:incoming>l1_o2c_Flow_6</bpmn:incoming>
      <bpmn:outgoing>l1_o2c_Flow_7</bpmn:outgoing>
      <bpmn:outgoing>l1_o2c_Flow_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="l1_o2c_exit2" name="Belum lanjut; periksa hasil aksi">
      <bpmn:incoming>l1_o2c_Flow_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="l1_o2c_end" name="Tahap selesai">
      <bpmn:incoming>l1_o2c_Flow_8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:callActivity id="l1_o2c_correction" name="Koreksi dokumen yang ada" calledElement="c3:Process_l2_sales_correction">
      <bpmn:incoming>l1_o2c_Flow_11</bpmn:incoming>
      <bpmn:outgoing>l1_o2c_Flow_12</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:endEvent id="l1_o2c_corrected" name="Hasil koreksi diterima">
      <bpmn:incoming>l1_o2c_Flow_12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="l1_o2c_Flow_0" sourceRef="l1_o2c_stage0" targetRef="l1_o2c_gate0"/>
    <bpmn:sequenceFlow id="l1_o2c_Flow_1" sourceRef="l1_o2c_gate0" targetRef="l1_o2c_exit0" name="Tidak"/>
    <bpmn:sequenceFlow id="l1_o2c_Flow_2" sourceRef="l1_o2c_gate0" targetRef="l1_o2c_stage1" name="Ya">
      <bpmn:conditionExpression language="text/plain" xsi:type="bpmn:tFormalExpression">Ya</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="l1_o2c_Flow_3" sourceRef="l1_o2c_stage1" targetRef="l1_o2c_gate1"/>
    <bpmn:sequenceFlow id="l1_o2c_Flow_4" sourceRef="l1_o2c_gate1" targetRef="l1_o2c_exit1" name="Tidak"/>
    <bpmn:sequenceFlow id="l1_o2c_Flow_5" sourceRef="l1_o2c_gate1" targetRef="l1_o2c_stage2" name="Ya">
      <bpmn:conditionExpression language="text/plain" xsi:type="bpmn:tFormalExpression">Ya</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="l1_o2c_Flow_6" sourceRef="l1_o2c_stage2" targetRef="l1_o2c_gate2"/>
    <bpmn:sequenceFlow id="l1_o2c_Flow_7" sourceRef="l1_o2c_gate2" targetRef="l1_o2c_exit2" name="Tidak"/>
    <bpmn:sequenceFlow id="l1_o2c_Flow_8" sourceRef="l1_o2c_gate2" targetRef="l1_o2c_end" name="Ya">
      <bpmn:conditionExpression language="text/plain" xsi:type="bpmn:tFormalExpression">Ya</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="l1_o2c_Flow_9" sourceRef="l1_o2c_start" targetRef="l1_o2c_mode"/>
    <bpmn:sequenceFlow id="l1_o2c_Flow_10" sourceRef="l1_o2c_mode" targetRef="l1_o2c_stage0" name="Proses baru">
      <bpmn:conditionExpression language="text/plain" xsi:type="bpmn:tFormalExpression">Proses baru</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="l1_o2c_Flow_11" sourceRef="l1_o2c_mode" targetRef="l1_o2c_correction" name="Koreksi"/>
    <bpmn:sequenceFlow id="l1_o2c_Flow_12" sourceRef="l1_o2c_correction" targetRef="l1_o2c_corrected"/>
  </bpmn:process>
