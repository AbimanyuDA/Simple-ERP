<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:tns="https://simple-erp.local/bpm-haqi/l1-reporting" xmlns:c0="https://simple-erp.local/bpm-haqi/l2-reporting" id="Definitions_l1_reporting" targetNamespace="https://simple-erp.local/bpm-haqi/l1-reporting" exporter="Simple ERP source-backed documentation" exporterVersion="1">
  <bpmn:import namespace="https://simple-erp.local/bpm-haqi/l2-reporting" location="../level-2/l2-reporting.bpmn" importType="http://www.omg.org/spec/BPMN/20100524/MODEL"/>
  <bpmn:process id="Process_l1_reporting" name="Monitoring, laporan dan audit" isExecutable="false">
    <bpmn:documentation>Level 1; source snapshot 2026-10-21; descriptive as-is working tree, not deployed-runtime proof.
Dekomposisi kapabilitas. Pilihan tahap tidak melewati precondition status di L2/L3; bukan semua tahap dijalankan berurutan oleh gateway.</bpmn:documentation>
    <bpmn:laneSet id="Lanes_l1_reporting">
      <bpmn:lane id="Lane_l1_reporting_0" name="Pemilik kebutuhan (role pada detail)">
        <bpmn:flowNodeRef>l1_reporting_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l1_reporting_choose</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l1_reporting_call0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l1_reporting_end0</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="l1_reporting_start" name="Kebutuhan muncul">
      <bpmn:outgoing>l1_reporting_Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="l1_reporting_choose" name="Pilih kebutuhan">
      <bpmn:incoming>l1_reporting_Flow_0</bpmn:incoming>
      <bpmn:outgoing>l1_reporting_Flow_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:callActivity id="l1_reporting_call0" name="Baca dan telusuri transaksi" calledElement="c0:Process_l2_reporting">
      <bpmn:incoming>l1_reporting_Flow_1</bpmn:incoming>
      <bpmn:outgoing>l1_reporting_Flow_2</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:endEvent id="l1_reporting_end0" name="Aksi selesai / hasil diterima">
      <bpmn:incoming>l1_reporting_Flow_2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="l1_reporting_Flow_0" sourceRef="l1_reporting_start" targetRef="l1_reporting_choose"/>
    <bpmn:sequenceFlow id="l1_reporting_Flow_1" sourceRef="l1_reporting_choose" targetRef="l1_reporting_call0"/>
    <bpmn:sequenceFlow id="l1_reporting_Flow_2" sourceRef="l1_reporting_call0" targetRef="l1_reporting_end0"/>
  </bpmn:process>
  <bpmn:collaboration id="Collab_l1_reporting">
    <bpmn:participant id="Pool_l1_reporting" name="Simple ERP" processRef="Process_l1_reporting"/>
  </bpmn:collaboration>
  <bpmndi:BPMNDiagram id="Diagram_l1_reporting">
    <bpmndi:BPMNPlane id="Plane_l1_reporting" bpmnElement="Collab_l1_reporting">
      <bpmndi:BPMNShape id="Pool_l1_reporting_di" bpmnElement="Pool_l1_reporting" isHorizontal="true">
        <dc:Bounds x="20" y="100" width="1280" height="260"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_l1_reporting_0_di" bpmnElement="Lane_l1_reporting_0" isHorizontal="true">
        <dc:Bounds x="50" y="100.0" width="1250" height="260.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="l1_reporting_start_di" bpmnElement="l1_reporting_start">
        <dc:Bounds x="200" y="211.0" width="38" height="38"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="145" y="254.0" width="148" height="45"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="l1_reporting_choose_di" bpmnElement="l1_reporting_choose">
        <dc:Bounds x="310" y="185.0" width="178" height="90"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="l1_reporting_call0_di" bpmnElement="l1_reporting_call0">
        <dc:Bounds x="850" y="145" width="178" height="90"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="l1_reporting_end0_di" bpmnElement="l1_reporting_end0">
        <dc:Bounds x="1120" y="171" width="38" height="38"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1065" y="214" width="148" height="45"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="l1_reporting_Flow_0_di" bpmnElement="l1_reporting_Flow_0">
        <di:waypoint x="238" y="230.0"/>
        <di:waypoint x="274.0" y="230.0"/>
        <di:waypoint x="274.0" y="230.0"/>
        <di:waypoint x="310" y="230.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="l1_reporting_Flow_1_di" bpmnElement="l1_reporting_Flow_1">
        <di:waypoint x="488" y="230.0"/>
        <di:waypoint x="669.0" y="230.0"/>
        <di:waypoint x="669.0" y="190.0"/>
        <di:waypoint x="850" y="190.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="l1_reporting_Flow_2_di" bpmnElement="l1_reporting_Flow_2">
        <di:waypoint x="1028" y="190.0"/>
        <di:waypoint x="1074.0" y="190.0"/>
        <di:waypoint x="1074.0" y="190.0"/>
        <di:waypoint x="1120" y="190.0"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
