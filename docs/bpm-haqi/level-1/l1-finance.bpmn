<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:tns="https://simple-erp.local/bpm-haqi/l1-finance" xmlns:c0="https://simple-erp.local/bpm-haqi/l2-ap" xmlns:c1="https://simple-erp.local/bpm-haqi/l2-ar" xmlns:c2="https://simple-erp.local/bpm-haqi/l2-finance-correction" id="Definitions_l1_finance" targetNamespace="https://simple-erp.local/bpm-haqi/l1-finance" exporter="Simple ERP source-backed documentation" exporterVersion="1">
  <bpmn:import namespace="https://simple-erp.local/bpm-haqi/l2-ap" location="../level-2-p2p/l2-ap.bpmn" importType="http://www.omg.org/spec/BPMN/20100524/MODEL"/>
  <bpmn:import namespace="https://simple-erp.local/bpm-haqi/l2-ar" location="../level-2/l2-ar.bpmn" importType="http://www.omg.org/spec/BPMN/20100524/MODEL"/>
  <bpmn:import namespace="https://simple-erp.local/bpm-haqi/l2-finance-correction" location="../level-2/l2-finance-correction.bpmn" importType="http://www.omg.org/spec/BPMN/20100524/MODEL"/>
  <bpmn:process id="Process_l1_finance" name="Finance AP dan AR" isExecutable="false">
    <bpmn:documentation>Level 1; source snapshot 2026-10-21; descriptive as-is working tree, not deployed-runtime proof.
Dekomposisi kapabilitas. Pilihan tahap tidak melewati precondition status di L2/L3; bukan semua tahap dijalankan berurutan oleh gateway.</bpmn:documentation>
    <bpmn:laneSet id="Lanes_l1_finance">
      <bpmn:lane id="Lane_l1_finance_0" name="Pemilik kebutuhan (role pada detail)">
        <bpmn:flowNodeRef>l1_finance_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l1_finance_choose</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l1_finance_branch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l1_finance_call0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l1_finance_end0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l1_finance_call1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l1_finance_end1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l1_finance_call2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l1_finance_end2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="l1_finance_start" name="Kebutuhan muncul">
      <bpmn:outgoing>l1_finance_Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="l1_finance_choose" name="Pilih kebutuhan">
      <bpmn:incoming>l1_finance_Flow_0</bpmn:incoming>
      <bpmn:outgoing>l1_finance_Flow_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="l1_finance_branch" name="Kebutuhan apa?" default="l1_finance_Flow_6" gatewayDirection="Diverging">
      <bpmn:incoming>l1_finance_Flow_1</bpmn:incoming>
      <bpmn:outgoing>l1_finance_Flow_2</bpmn:outgoing>
      <bpmn:outgoing>l1_finance_Flow_4</bpmn:outgoing>
      <bpmn:outgoing>l1_finance_Flow_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="l1_finance_call0" name="Accounts Payable" calledElement="c0:Process_l2_ap">
      <bpmn:incoming>l1_finance_Flow_2</bpmn:incoming>
      <bpmn:outgoing>l1_finance_Flow_3</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:endEvent id="l1_finance_end0" name="Aksi selesai / hasil diterima">
      <bpmn:incoming>l1_finance_Flow_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:callActivity id="l1_finance_call1" name="Accounts Receivable" calledElement="c1:Process_l2_ar">
      <bpmn:incoming>l1_finance_Flow_4</bpmn:incoming>
      <bpmn:outgoing>l1_finance_Flow_5</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:endEvent id="l1_finance_end1" name="Aksi selesai / hasil diterima">
      <bpmn:incoming>l1_finance_Flow_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:callActivity id="l1_finance_call2" name="Koreksi keuangan" calledElement="c2:Process_l2_finance_correction">
      <bpmn:incoming>l1_finance_Flow_6</bpmn:incoming>
      <bpmn:outgoing>l1_finance_Flow_7</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:endEvent id="l1_finance_end2" name="Aksi selesai / hasil diterima">
      <bpmn:incoming>l1_finance_Flow_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="l1_finance_Flow_0" sourceRef="l1_finance_start" targetRef="l1_finance_choose"/>
    <bpmn:sequenceFlow id="l1_finance_Flow_1" sourceRef="l1_finance_choose" targetRef="l1_finance_branch"/>
    <bpmn:sequenceFlow id="l1_finance_Flow_2" sourceRef="l1_finance_branch" targetRef="l1_finance_call0" name="Accounts Payable">
      <bpmn:conditionExpression language="text/plain" xsi:type="bpmn:tFormalExpression">Accounts Payable</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="l1_finance_Flow_3" sourceRef="l1_finance_call0" targetRef="l1_finance_end0"/>
    <bpmn:sequenceFlow id="l1_finance_Flow_4" sourceRef="l1_finance_branch" targetRef="l1_finance_call1" name="Accounts Receivable">
      <bpmn:conditionExpression language="text/plain" xsi:type="bpmn:tFormalExpression">Accounts Receivable</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="l1_finance_Flow_5" sourceRef="l1_finance_call1" targetRef="l1_finance_end1"/>
    <bpmn:sequenceFlow id="l1_finance_Flow_6" sourceRef="l1_finance_branch" targetRef="l1_finance_call2" name="Koreksi keuangan"/>
    <bpmn:sequenceFlow id="l1_finance_Flow_7" sourceRef="l1_finance_call2" targetRef="l1_finance_end2"/>
  </bpmn:process>
  <bpmn:collaboration id="Collab_l1_finance">
    <bpmn:participant id="Pool_l1_finance" name="Simple ERP" processRef="Process_l1_finance"/>
  </bpmn:collaboration>
  <bpmndi:BPMNDiagram id="Diagram_l1_finance">
    <bpmndi:BPMNPlane id="Plane_l1_finance" bpmnElement="Collab_l1_finance">
