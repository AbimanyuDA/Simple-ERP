# Copy to .env for local development. Keep real values out of Git.
APP_ENV=development
APP_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:8080
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5432
POSTGRES_DB=simple_erp
POSTGRES_USER=simple_erp
POSTGRES_PASSWORD=
# Used only by native backend CLI commands. Compose builds its container URL
# from the POSTGRES_* values above. In PowerShell, use localhost as the host.
DATABASE_URL=postgres://simple_erp:replace-me@localhost:5432/simple_erp?sslmode=disable

# Generate unique local values; do not commit populated secrets.
SESSION_PEPPER=

BACKEND_HOST_PORT=8080
FRONTEND_HOST_PORT=3000

DEFAULT_CURRENCY=IDR
DEFAULT_TIMEZONE=Asia/Jakarta
DEFAULT_WAREHOUSE_CODE=MAIN
